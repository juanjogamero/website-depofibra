---
import Layout from '../../layouts/Layout.astro';
const title = 'Confirmación de consulta | Depofibra';
const description = 'Información sobre la solicitud de presupuesto desde el formulario de Depofibra.';
---
<Layout title={title} description={description} canonical="https://depofibra.com/solicitud-enviada/" activeNav="contacto" indexable={false}>
  <meta slot="head" name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
  <div class="confirmation-page">
    <div class="container">
      <div class="confirmation-card">
        <div class="confirmation-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7" /></svg>
        </div>
        <p class="confirmation-eyebrow">CONTACTO COMERCIAL · DEPOFIBRA</p>
        <h1 id="confirmationTitle">Solicitar presupuesto</h1>
        <p id="confirmationMessage">Esta página se muestra después de enviar una consulta desde nuestra web. Si has llegado aquí directamente, puedes abrir el formulario desde cualquiera de las páginas de productos.</p>
        <p class="confirmation-hint">La aceptación del envío por el servicio de formularios no garantiza la entrega del correo. No se ha generado ningún presupuesto ni se ha reservado ningún producto. Para consultas urgentes, llama al <a href="tel:+34642129233">642 129 233</a>.</p>
        <div class="confirmation-actions">
          <a href="/" class="confirmation-button confirmation-button--main">Volver al inicio <span aria-hidden="true">↗</span></a>
          <a href="/depositos/" class="confirmation-button">Ver depósitos <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </div>
</Layout>
<style>
  .confirmation-page{min-height:68vh;display:grid;align-items:center;padding:70px 0 90px;background:#f6f8fb}
  .confirmation-card{max-width:740px;margin:0 auto;padding:clamp(26px,6vw,64px);border:1px solid #d8e5ee;border-radius:24px;background:#fff;text-align:left}
  .confirmation-mark{display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#eaf2fb;color:#01488e;margin-bottom:26px}
  .confirmation-mark svg{width:27px;height:27px}
  .confirmation-eyebrow{font:800 11px/1.3 var(--font-display);letter-spacing:.12em;color:#01488e;margin:0 0 14px}
  .confirmation-card h1{font:800 clamp(34px,5vw,58px)/1.05 var(--font-display);letter-spacing:-.06em;color:#10203a;margin:0 0 20px}
  .confirmation-card>p:not(.confirmation-eyebrow){font:400 16px/1.8 var(--font-body);color:#516478;max-width:620px}
  .confirmation-hint{padding-top:18px;border-top:1px solid #dfe7ef;margin-top:24px}
  .confirmation-hint a{color:#01488e;font-weight:700;text-decoration:underline;text-underline-offset:3px}
  .confirmation-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
  .confirmation-button{display:inline-flex;align-items:center;justify-content:center;min-height:49px;padding:0 22px;border:1px solid #b9cedf;border-radius:999px;background:#fff;color:#01488e;text-decoration:none;font:800 13px var(--font-display)}
  .confirmation-button:hover{border-color:#01488e}
  .confirmation-button--main{background:#01488e;border-color:#01488e;color:#fff}
  .confirmation-button--main:hover{background:#002d59}
  @media(max-width:550px){.confirmation-page{padding:30px 0 60px}}
</style>
<script>
  // Unicamente la respuesta AJAX positiva del formulario de ESTA web coloca
  // el marcador de una sola visita. La URL publica por si sola NO confirma nada.
  let accepted = false;
  let submittedFrom = '';
  try {
    accepted = sessionStorage.getItem('depofibra-form-success-v1') === '1';
    if (accepted) submittedFrom = sessionStorage.getItem('depofibra-form-origin-path-v1') || '';
    sessionStorage.removeItem('depofibra-form-success-v1');
    sessionStorage.removeItem('depofibra-form-origin-path-v1');
  } catch { /* En navegadores sin storage se mostrara el texto neutro */ }
  if (accepted) {
    const heading = document.getElementById('confirmationTitle');
    const paragraph = document.getElementById('confirmationMessage');
    if (heading) heading.textContent = 'Gracias por tu consulta.';
    if (paragraph) paragraph.textContent = 'El servicio de envío ha aceptado tu solicitud. Revisaremos la información que nos has facilitado y nos pondremos en contacto contigo cuando podamos atenderla.';

    // Un único evento si el proveedor confirmó el envío y las cookies analíticas
    // están aceptadas. La landing por URL directa nunca produce este evento.
    const announceAccepted = () => {
      try {
        const pref = JSON.parse(localStorage.getItem('depofibra-cookie-preferences') || 'null');
        if (pref?.version !== 'depofibra-cookies-v2-ga4-consent' || pref.analytics !== true) return;
        const layer = (window as any).dataLayer;
        // Evitar PII: solo una ruta estática sin query, hash ni datos introducidos.
        // GTM debe mapear source_page_path a GA4 para disponer del dato en informes.
        const safeSource = /^\/(?:[a-z0-9-]+\/)*$/.test(submittedFrom) && submittedFrom.length <= 140
          ? submittedFrom : '';
        if (Array.isArray(layer)) layer.push(safeSource
          ? {event: 'quote_form_provider_accepted', source_page_path: safeSource}
          : {event: 'quote_form_provider_accepted'});
      } catch { /* La web funciona sin analítica si no hay acceso al almacenamiento */ }
    };
    if (document.readyState === 'complete') announceAccepted();
    else window.addEventListener('load', announceAccepted, {once: true});
  }
</script>
