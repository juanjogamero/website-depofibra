---
import Layout from '../../layouts/Layout.astro';
import { verticalTanksAR } from '../../data/verticalTanksAR';
import { vasosAR } from '../../data/vasosAR';
import '../../components/space/space.css';

const initial = verticalTanksAR.find(t => t.liters === 10000) ?? verticalTanksAR[0];
const title = 'Depofibra en tu espacio | Visualizador 3D';
const description = 'Visualiza un depósito vertical o tipo vaso en 3D y colócalo a escala orientativa en tu espacio con realidad aumentada.';
---
<Layout {title} {description} indexable={false} activeNav="depositos">
  <div class="space-page">
    <div class="space-container">
      <nav class="space-breadcrumb" aria-label="Ruta de navegación">
        <a href="/depositos/">Depósitos</a><span aria-hidden="true">/</span><span aria-current="page">En tu espacio</span>
      </nav>
      <header class="space-hero">
        <div class="space-heading">
          <p class="space-eyebrow">DEPOFIBRA / VISUALIZADOR 3D</p>
          <h1>Depofibra <span>en tu espacio.</span></h1>
        </div>
        <p>Descubre cómo quedaría tu depósito. Elige un modelo, cambia su color y míralo en tu propio espacio con la cámara.</p>
      </header>

      <section class="space-choose" aria-labelledby="space-choose-title">
        <div class="space-section-title">
          <h2 id="space-choose-title">Elige tu depósito</h2>
          <span>01 / 02</span>
        </div>
        <div class="space-families" role="group" aria-label="Familia de depósito">
          <button class="space-family is-active" data-space-family="vertical" type="button" aria-pressed="true">
            <span class="space-family-art" aria-hidden="true">
              <svg viewBox="0 0 112 112"><path d="M25 30c0-13 15-20 31-20s31 7 31 20v57c0 13-15 19-31 19S25 100 25 87V30Z" fill="#edf2f5" stroke="#7895a8" stroke-width="1.8"/><path d="M25 30c0 11 14 19 31 19s31-8 31-19" stroke="#8ca7ba" stroke-width="1.8"/><path d="M42 13v-5c0-7 28-7 28 0v5" fill="none" stroke="#7895a8" stroke-width="2"/><path d="M54 54v43" stroke="#1c6b50" stroke-width="4" /></svg>
            </span>
            <span class="space-family-copy">
              <span>17 CONFIGURACIONES</span>
              <strong>Verticales de base plana</strong>
              <small>De 5.000 a 60.000 litros</small>
            </span>
            <span class="space-family-arrow" aria-hidden="true">↗</span>
          </button>
          <button class="space-family" data-space-family="vasos" type="button" aria-pressed="false">
            <span class="space-family-art" aria-hidden="true">
              <svg viewBox="0 0 112 112"><path d="M17 28c0-11 17-17 39-17s39 6 39 17L82 90c-3 10-18 16-26 16s-24-6-26-16L17 28Z" fill="#edf2f5" stroke="#7895a8" stroke-width="1.8"/><ellipse cx="56" cy="28" rx="39" ry="14" fill="#f7f9fa" stroke="#7895a8" stroke-width="1.8"/><ellipse cx="56" cy="23" rx="15" ry="5" fill="#e6edf0" stroke="#7895a8" stroke-width="1.7"/></svg>
            </span>
            <span class="space-family-copy">
              <span>8 CAPACIDADES</span>
              <strong>Depósitos tipo vaso</strong>
              <small>De 110 a 4.000 litros</small>
            </span>
            <span class="space-family-arrow" aria-hidden="true">↗</span>
          </button>
        </div>
      </section>

      <section class="space-workbench" id="space-studio" aria-label="Visualizador interactivo">
        <div class="space-viewer-wrap">
          <figure class="space-stage">
            <div class="space-canvas">
              <span class="space-stage-tag">VISTA 3D <span aria-hidden="true">·</span> AR DISPONIBLE EN MÓVILES COMPATIBLES</span>
              <div id="space-model-host" class="space-model-host"></div>
              <p id="space-load" class="space-load" role="status">Preparando el modelo 3D…</p>
              <button class="space-retry" id="space-retry" type="button" hidden>Reintentar</button>
              <div class="space-zoom" role="group" aria-label="Controles del modelo">
                <button id="space-zoom-out" type="button" disabled aria-label="Alejar modelo">−</button>
                <button id="space-zoom-in" type="button" disabled aria-label="Acercar modelo">+</button>
                <button id="space-reset" type="button" disabled aria-label="Restablecer vista">↺</button>
              </div>
            </div>
            <figcaption>
              <strong id="space-model-title">{initial.label}</strong>
              <span>Arrastra para girar · Pellizca para ampliar</span>
            </figcaption>
          </figure>
        </div>
        <aside class="space-config" aria-label="Personalización del depósito">
          <div class="space-config-heading">
            <p class="space-eyebrow">PERSONALIZA Y VISUALIZA</p>
            <h2 id="space-config-title">Vertical de base plana</h2>
            <p id="space-config-description">Elige el tamaño y el acabado.</p>
          </div>

          <div class="space-field">
            <label for="space-size-vertical" id="space-size-label">Capacidad</label>
            <select id="space-size-vertical">
              {verticalTanksAR.map(t => <option value={t.id} selected={t.id===initial.id}
                data-src={t.url} data-diameter={t.diameter} data-height={t.longitudinal} data-note={t.note}
                data-large={t.longitudinalMm >= 6000 ? 'true':'false'}>{t.label}</option>)}
            </select>
            <select id="space-size-vasos" aria-label="Capacidad del vaso" disabled hidden>
              {vasosAR.map(t => <option value={t.id} data-src={t.url} data-diameter={t.diameter}
                data-height={t.height} data-note={t.note}>{t.label}</option>)}
            </select>
          </div>

          <fieldset class="space-colors" id="space-color-field">
            <legend>Color</legend>
            <div class="space-color-row" role="group" aria-label="Acabado visual">
              <button type="button" data-space-color="verde" class="space-color is-active" aria-pressed="true"><span class="space-color-swatch green" aria-hidden="true"></span>Verde</button>
              <button type="button" data-space-color="blanco" class="space-color" aria-pressed="false"><span class="space-color-swatch white" aria-hidden="true"></span>Blanco</button>
              <button type="button" data-space-color="gris" class="space-color" aria-pressed="false"><span class="space-color-swatch gray" aria-hidden="true"></span>Gris</button>
              <button type="button" data-space-color="negro" class="space-color" aria-pressed="false"><span class="space-color-swatch black" aria-hidden="true"></span>Negro</button>
              <label class="space-color custom" id="space-color-custom-label">
                <input id="space-custom-color" type="color" value="#ad724b" aria-label="Escoger un color personalizado" />
                A medida
              </label>
            </div>
          </fieldset>

          <dl class="space-dimensions" aria-live="polite" aria-atomic="true">
            <div><dt>Diámetro de ficha</dt><dd id="space-diameter">{initial.diameter}</dd></div>
            <div><dt id="space-height-label">Cota longitudinal de ficha</dt><dd id="space-height">{initial.longitudinal}</dd></div>
          </dl>

          <label class="space-scale-verify" for="space-scale-reference">
            <input id="space-scale-reference" type="checkbox" />
            <span><strong>Comprobar escala</strong><small>Mostrar una regla virtual de 1 metro</small></span>
          </label>
          <button type="button" class="space-button-primary" id="space-launch" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H4v4m12-4h4v4M4 17v4h4m12-4v4h-4M7 9l5-3 5 3v6l-5 3-5-3Zm0 0 5 3 5-3m-5 3v6"/></svg>
            Ver en mi espacio
          </button>
          <a id="space-open-chrome" class="space-button-primary space-external-browser" href="/visualizador/" hidden> 
            Abrir en Chrome para ver en mi espacio
          </a>
          <a id="space-ios-open-chrome" class="space-button-primary space-external-browser" href="/visualizador/" hidden>Ver en mi espacio</a>
          <a id="space-ios-quicklook" class="space-button-secondary space-ios-quicklook" rel="ar" href="/visualizador/" hidden>
            <img alt="" width="1" height="1" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" />
            Abrir AR directamente
          </a>
          <button id="space-copy-link" class="space-button-secondary space-copy-browser" type="button" hidden>Copiar enlace</button>
          <p class="space-support" id="space-support" role="status">Comprobando compatibilidad con tu móvil…</p>
          <details class="space-handoff" id="space-handoff">
            <summary>Enviar esta selección al móvil</summary>
            <div class="space-qr"><img id="space-qr-img" width="120" height="120" alt="Código QR de esta selección"/><p>Escanea el código con el móvil.</p></div>
          </details>
          <button type="button" class="space-button-secondary open-quote-trigger" id="space-quote" data-product="Depósito" data-note={initial.note}>
            Pedir presupuesto <span aria-hidden="true">↗</span>
          </button>
          <p class="space-far" id="space-distance" hidden>Para verlo completo, colócate en una zona despejada y aléjate unos pasos.</p>
        </aside>
      </section>

      <details class="space-disclaimer">
        <summary>¿Son exactas las medidas?</summary>
        <p>La escala es orientativa. El diámetro y la altura de los vasos proceden de la tabla facilitada; su perfil y tapa se han interpretado a partir de fotografías. En los depósitos verticales, bocas, tapa y graduación son ilustrativas. Consulta dimensiones exteriores y acabados disponibles antes de instalar.</p>
      </details>
    </div>
  </div>
  <script>import '../../components/space/space-viewer';</script>
</Layout>