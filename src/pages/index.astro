---
/**
 * DEPOFIBRA — PÁGINA DE INICIO
 * Home completa mobile-first con todas las secciones del prompt maestro.
 *
 * NOTA SOBRE FOTOGRAFÍAS:
 * - Las imágenes de /images/productos/ son fotografías aportadas por el propietario.
 *   La imagen deposito-vertical.jpg contiene la marca "DecaSur" del fabricante.
 *   No se elimina para no atribuir fabricación a Depofibra.
 *   Antes de publicar, confirmar autorización de uso web.
 * - Las imágenes de Unsplash son contextuales/ambientales, con licencia verificable.
 */
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Depósitos de poliéster para agua y riego | Depofibra"
  description="Depósitos de poliéster PRFV para agua y riego: modelos verticales, horizontales y enterrables. También piscinas, fosas y cisternas. Consulta presupuesto con entrega."
  activeNav="inicio"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://depofibra.com/#organization",
          "name": "Depofibra",
          "url": "https://depofibra.com/",
          "description": "Comercialización de depósitos de poliéster reforzado con fibra de vidrio (PRFV), piscinas prefabricadas, fosas sépticas, cubas y cisternas.",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Casariche",
            "addressRegion": "Sevilla",
            "addressCountry": "ES"
          },
          "sameAs": [
            "https://www.instagram.com/depofibra/",
            "https://www.facebook.com/p/Juan-Depofibra-61589376342997/"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://depofibra.com/#website",
          "url": "https://depofibra.com/",
          "name": "Depofibra",
          "inLanguage": "es-ES",
          "publisher": { "@id": "https://depofibra.com/#organization" }
        },
        {
          "@type": "WebPage",
          "@id": "https://depofibra.com/#webpage",
          "url": "https://depofibra.com/",
          "name": "Depósitos de poliéster para agua y riego | Depofibra",
          "inLanguage": "es-ES",
          "isPartOf": { "@id": "https://depofibra.com/#website" },
          "about": { "@id": "https://depofibra.com/#organization" }
        },
        {
          "@type": "ItemList",
          "@id": "https://depofibra.com/#catalogo-principal",
          "name": "Familias de productos de Depofibra",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Depósitos de poliéster", "url": "https://depofibra.com/depositos/" },
            { "@type": "ListItem", "position": 2, "name": "Piscinas de poliéster", "url": "https://depofibra.com/piscinas/" },
            { "@type": "ListItem", "position": 3, "name": "Fosas sépticas", "url": "https://depofibra.com/fosas-septicas/" },
            { "@type": "ListItem", "position": 4, "name": "Cubas y cisternas", "url": "https://depofibra.com/cubas-cisternas/" }
          ]
        }
      ]
    })} />
  </Fragment>

  <!-- ═══════════════════════════════════════════════
       SECCIÓN 1 — HERO PRINCIPAL
       ═══════════════════════════════════════════════ -->
  <section class="hero" aria-label="Presentación de Depofibra">
    <div class="hero__bg" aria-hidden="true">
      <img
        src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1600&q=80"
        alt=""
        fetchpriority="high"
        width="1600"
        height="900"
      />
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="hero__content container">
      <h1 class="hero__title">
        Depósitos de poliéster<br />para agua, riego y otros usos
      </h1>
      <p class="hero__desc">
        Comercializamos depósitos de poliéster reforzado con fibra de vidrio (PRFV), piscinas prefabricadas, fosas sépticas y cisternas. Explora las categorías y solicita presupuesto con transporte para tu localidad.
      </p>
      <div class="hero__actions">
        <a href="#catalogo" class="btn btn--white">
          Ver productos
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </a>
        <button class="btn btn--secondary hero__cta-quote open-quote-trigger" type="button">
          Pedir presupuesto
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SECCIÓN 2 — CATÁLOGO DE 4 FAMILIAS
       ═══════════════════════════════════════════════ -->
  <section class="catalog section" id="catalogo" aria-labelledby="catalog-heading">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">Catálogo de productos PRFV</span>
        <h2 class="heading-lg" id="catalog-heading">
          Depósitos, piscinas, fosas sépticas y cubas
        </h2>
        <p class="body-lg" style="max-width:800px;margin-inline:auto;">
          Encuentra tu producto PRFV, consulta las características y solicita un presupuesto ajustado a tu localidad.
        </p>
      </header>

      <div class="catalog__grid">
        <!-- Depósitos -->
        <a href="/depositos/" class="catalog-card" id="card-depositos">
          <div class="catalog-card__image">
            <img
              src="/images/productos/depositos-tipos.jpg"
              alt="Depósitos de poliéster: verticales de base plana, horizontales con cunas y vertical con patas"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
          <div class="catalog-card__body">
            <h3 class="catalog-card__title">Depósitos</h3>
            <p class="catalog-card__subtitle">Verticales, horizontales y enterrables</p>
            <span class="catalog-card__cta">
              Ver depósitos
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </span>
          </div>
        </a>

        <!-- Piscinas -->
        <a href="/piscinas/" class="catalog-card" id="card-piscinas">
          <div class="catalog-card__image">
            <img
              src="/images/productos/piscina-poliester.jpg"
              alt="Piscina de poliéster prefabricada instalada en un patio con escaleras interiores"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
          <div class="catalog-card__body">
            <h3 class="catalog-card__title">Piscinas</h3>
            <p class="catalog-card__subtitle">Prefabricadas de poliéster</p>
            <span class="catalog-card__cta">
              Explorar piscinas
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </span>
          </div>
        </a>

        <!-- Fosas sépticas -->
        <a href="/fosas-septicas/" class="catalog-card" id="card-fosas">
          <div class="catalog-card__image catalog-card__image--illustration">
            <div class="catalog-card__art" aria-hidden="true">
              <svg viewBox="0 0 320 230">
                <ellipse cx="160" cy="180" fill="#cbd5e1" opacity=".5" rx="110" ry="10"></ellipse>
                <path d="M61 98c-24 0-24 65 0 65h198c24 0 24-65 0-65z" fill="#fff" stroke="#01488e" stroke-width="3"></path>
                <path d="M96 98c9 13 9 52 0 65m47-65c9 13 9 52 0 65m47-65c9 13 9 52 0 65m47-65c9 13 9 52 0 65" fill="none" stroke="#9bb9d7" stroke-width="2"></path>
                <path d="M82 98V72h26v26m101 0V67h27v31" fill="#eaf2fb" stroke="#01488e" stroke-width="3"></path>
                <ellipse cx="95" cy="72" fill="#fff" rx="13" ry="4" stroke="#01488e" stroke-width="2"></ellipse>
                <ellipse cx="222.5" cy="67" fill="#fff" rx="13.5" ry="4" stroke="#01488e" stroke-width="2"></ellipse>
              </svg>
            </div>
          </div>
          <div class="catalog-card__body">
            <h3 class="catalog-card__title">Fosas sépticas</h3>
            <p class="catalog-card__subtitle">Estancas, filtro biológico y oxidación total</p>
            <span class="catalog-card__cta">
              Ver opciones
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </span>
          </div>
        </a>

        <!-- Cubas y cisternas -->
        <a href="/cubas-cisternas/" class="catalog-card" id="card-cubas">
          <div class="catalog-card__image">
            <img
              src="/images/productos/deposito-horizontal.jpg"
              alt="Depósito horizontal de poliéster con patas de apoyo, exterior en campo"
              loading="lazy"
              width="600"
              height="400"
            />
          </div>
          <div class="catalog-card__body">
            <h3 class="catalog-card__title">Cubas y cisternas</h3>
            <p class="catalog-card__subtitle">Cubas agrícolas y depósitos cisterna</p>
            <span class="catalog-card__cta">
              Consultar cubas
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SECCIÓN 3 — TIPOS DE DEPÓSITOS
       ═══════════════════════════════════════════════ -->
  <section class="capacities section section--alt" id="tipos-de-depositos" aria-labelledby="capacities-heading">
    <div class="container">
      <div class="capacities__layout">
        <div class="capacities__intro">
          <span class="eyebrow">Distintas formas y capacidades</span>
          <h2 class="heading-lg" id="capacities-heading">
            Depósitos de poliéster para diferentes necesidades
          </h2>
          <p class="body-lg">
            No todos los proyectos necesitan el mismo depósito. Comercializamos <strong>modelos verticales, horizontales, enterrables y de formato compacto</strong>, con distintas capacidades y configuraciones según la referencia. Elige la familia que mejor se adapte al espacio y al uso previsto.
          </p>
          <a href="/depositos/" class="btn btn--ghost btn--sm">
            Ver todos los tipos de depósitos
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        </div>

        <div class="capacities__table" role="list" aria-label="Tipos de depósitos de poliéster">
          <div class="capacities__row" role="listitem">
            <div class="capacities__amount">
              <strong>Verticales</strong>
              <span>De base plana o con patas</span>
            </div>
            <p>Para instalaciones en superficie, con distintas alturas, diámetros y capacidades según el modelo.</p>
            <button class="btn btn--secondary btn--sm open-quote-trigger" data-product="Depósito vertical de poliéster" type="button">
              Consultar <span aria-hidden="true">↗</span>
            </button>
          </div>

          <div class="capacities__row" role="listitem">
            <div class="capacities__amount">
              <strong>Horizontales</strong>
              <span>Con cunas de apoyo</span>
            </div>
            <p>Una alternativa de superficie cuando conviene aprovechar el espacio en horizontal.</p>
            <button class="btn btn--secondary btn--sm open-quote-trigger" data-product="Depósito horizontal con cunas" type="button">
              Consultar <span aria-hidden="true">↗</span>
            </button>
          </div>

          <div class="capacities__row" role="listitem">
            <div class="capacities__amount">
              <strong>Enterrables</strong>
              <span>Modelos específicos</span>
            </div>
            <p>Diseñados para instalarse bajo tierra, siempre de acuerdo con las condiciones técnicas de cada referencia.</p>
            <button class="btn btn--secondary btn--sm open-quote-trigger" data-product="Depósito horizontal enterrable" type="button">
              Consultar <span aria-hidden="true">↗</span>
            </button>
          </div>

          <div class="capacities__row" role="listitem">
            <div class="capacities__amount">
              <strong>Compactos</strong>
              <span>Tipo vaso y rectangulares</span>
            </div>
            <p>Formatos para necesidades de menor volumen y espacios con requisitos de forma concretos.</p>
            <button class="btn btn--secondary btn--sm open-quote-trigger" data-product="Depósito compacto tipo vaso o rectangular" type="button">
              Consultar <span aria-hidden="true">↗</span>
            </button>
          </div>

          <p class="capacities__note">
            Las capacidades, dimensiones, configuraciones y condiciones de suministro se comprueban para cada modelo con el proveedor.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SECCIÓN 4 — LOGÍSTICA Y ENTREGA
       ═══════════════════════════════════════════════ -->
  <section class="logistics section" id="logistica" aria-labelledby="logistics-heading">
    <div class="container">
      <div class="logistics__header">
        <span class="eyebrow">Logística y entrega</span>
        <h2 class="heading-lg" id="logistics-heading">
          Presupuesto con entrega según destino
        </h2>
        <p class="body-lg">
          Atendemos solicitudes para España y Portugal cuando el modelo y las condiciones logísticas lo permiten. El transporte se consulta según las dimensiones del producto, el código postal y los accesos de entrega.
        </p>
      </div>

      <div class="logistics__visual">
        <img
          src="https://images.unsplash.com/photo-1592982537447-7440770cbfc9?auto=format&fit=crop&w=1400&q=80"
          alt="Paisaje agrícola como contexto de uso para soluciones de almacenamiento de agua"
          loading="lazy"
          width="1400"
          height="600"
        />
        <div class="logistics__visual-overlay"></div>
        <div class="logistics__visual-card">
          <span class="logistics__visual-eyebrow">Depósitos de poliéster</span>
          <h3>¿Necesitas un depósito para tu proyecto?</h3>
          <p>Cuéntanos qué capacidad, tipo de depósito y destino necesitas. Revisaremos las opciones y las condiciones del transporte.</p>
          <button class="btn btn--primary btn--sm open-quote-trigger" data-product="Depósito de poliéster" type="button">
            Consultar opciones
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>

      <div class="logistics__details">
        <div class="logistics__info">
          <h3 class="heading-sm">Qué debes comprobar antes de recibir un depósito</h3>
          <p class="body-md">
            Para calcular el transporte necesitamos el modelo, el destino y los accesos. El transporte estándar no incluye la descarga: organiza con antelación los medios adecuados.
          </p>
          <ul class="logistics__facts">
            <li>España y Portugal según viabilidad logística</li>
            <li>El presupuesto depende del producto y código postal</li>
            <li>Descarga no incluida en el transporte estándar</li>
          </ul>
        </div>
        <div class="logistics__cta-box">
          <span class="eyebrow" style="margin-bottom:8px;">¿Necesitas calcular el transporte?</span>
          <p class="body-md">Indícanos el modelo o capacidad y la localidad con código postal.</p>
          <button class="btn btn--primary btn--full open-quote-trigger" type="button">
            Consultar precio con transporte
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SECCIÓN 5 — GUÍA PARA ELEGIR
       ═══════════════════════════════════════════════ -->
  <section class="guide section" id="guia-eleccion" aria-labelledby="guide-heading">
    <div class="container">
      <div class="guide__layout">
        <div class="guide__content">
          <span class="eyebrow">Guía para elegir</span>
          <h2 class="heading-lg" id="guide-heading">
            Cómo elegir un depósito de poliéster <span style="color:var(--color-primary)">sin equivocarte</span>
          </h2>
          <p class="body-lg">
            La elección depende de lo que vas a almacenar, dónde se instalará el depósito y cómo llegará a la parcela o nave.
          </p>

          <ol class="guide__steps">
            <li class="guide__step">
              <span class="guide__step-num" aria-hidden="true">01</span>
              <div>
                <h3>Uso del depósito y líquido a almacenar</h3>
                <p>No todos los depósitos son aptos para los mismos líquidos. Para agua de consumo humano, productos químicos o usos especiales, la referencia debe contar con la compatibilidad y documentación correspondientes.</p>
              </div>
            </li>
            <li class="guide__step">
              <span class="guide__step-num" aria-hidden="true">02</span>
              <div>
                <h3>Vertical, horizontal o enterrable</h3>
                <p>En superficie puedes valorar depósitos verticales de base plana u horizontales con apoyos. Para enterrar necesitas un modelo específicamente diseñado para ello.</p>
              </div>
            </li>
            <li class="guide__step">
              <span class="guide__step-num" aria-hidden="true">03</span>
              <div>
                <h3>Entradas, salidas y entrega en destino</h3>
                <p>Define el diámetro y posición de las conexiones, el código postal de entrega y los accesos. La descarga no está incluida en el transporte estándar.</p>
              </div>
            </li>
          </ol>

          <div class="guide__actions">
            <button class="btn btn--primary open-quote-trigger" type="button">
              Consultar mi caso
              <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
            </button>
            <a href="/depositos/" class="btn btn--secondary">Comparar tipos de depósito →</a>
          </div>
        </div>

        <figure class="guide__visual">
          <img
            src="https://images.unsplash.com/photo-1767022094253-e24308b8947e?auto=format&fit=crop&w=800&q=80"
            alt="Olivar en una ladera de Andalucía, como ejemplo del entorno agrícola en el que puede necesitarse almacenamiento de agua"
            loading="lazy"
            width="800"
            height="1000"
          />
          <figcaption>
            Fotografía ilustrativa · <a href="https://unsplash.com/photos/YOlMK-_PM50" target="_blank" rel="noopener noreferrer">Unsplash</a>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SECCIÓN 6 — PREGUNTAS FRECUENTES
       ═══════════════════════════════════════════════ -->
  <section class="faq section section--alt" id="preguntas-frecuentes" aria-labelledby="faq-heading">
    <div class="container">
      <div class="faq__layout">
        <div class="faq__intro">
          <span class="eyebrow">Preguntas frecuentes</span>
          <h2 class="heading-lg" id="faq-heading">Resolvemos tus dudas antes de elegir</h2>
          <p class="body-md">
            Respuestas prácticas a las consultas habituales antes de comprar un depósito de agua de poliéster.
          </p>
        </div>

        <div class="faq__list">
          <details class="faq__item">
            <summary>¿Dónde comprar depósitos de poliéster para riego?</summary>
            <div class="faq__answer">
              <p>En Depofibra puedes consultar depósitos de poliéster reforzado con fibra de vidrio (PRFV), también llamados depósitos de fibra de vidrio, para riego y otros usos compatibles. Atendemos consultas desde Casariche (Sevilla); el suministro depende del modelo y del destino.</p>
            </div>
          </details>

          <details class="faq__item">
            <summary>¿Qué capacidades y tipos de depósitos de poliéster hay?</summary>
            <div class="faq__answer">
              <p>Existen referencias de diferentes capacidades y formatos: depósitos verticales, horizontales, enterrables, tipo vaso y rectangulares. El modelo adecuado depende del volumen, el uso, el espacio disponible y las condiciones de instalación.</p>
            </div>
          </details>

          <details class="faq__item">
            <summary>¿Qué diferencia hay entre un depósito vertical y uno horizontal?</summary>
            <div class="faq__answer">
              <p>El depósito vertical de base plana se instala en superficie sobre una base adecuada; el horizontal de superficie utiliza apoyos o cunas. La elección depende de la altura y superficie disponibles.</p>
            </div>
          </details>

          <details class="faq__item">
            <summary>¿Puedo pedir precio con transporte incluido?</summary>
            <div class="faq__answer">
              <p>Sí. Indica la capacidad o el modelo, el uso previsto y la localidad con código postal. El coste del transporte se consulta según las dimensiones del depósito, el destino y los accesos.</p>
            </div>
          </details>

          <details class="faq__item">
            <summary>¿Se puede enterrar un depósito de poliéster?</summary>
            <div class="faq__answer">
              <p>Solo si es un modelo expresamente previsto para enterramiento. Un depósito horizontal de superficie no debe instalarse bajo tierra sin una especificación técnica que lo autorice.</p>
            </div>
          </details>

          <details class="faq__item">
            <summary>¿Todos los depósitos son aptos para agua potable?</summary>
            <div class="faq__answer">
              <p>No. Para almacenar agua destinada al consumo humano debes solicitar un modelo apto y documentación específica. No basta con que el material sea de poliéster.</p>
            </div>
          </details>

          <details class="faq__item">
            <summary>¿El transporte incluye la descarga?</summary>
            <div class="faq__answer">
              <p>No. El transporte estándar no incluye la descarga. Antes de la entrega es necesario prever accesos y medios de descarga adecuados.</p>
            </div>
          </details>

          <details class="faq__item">
            <summary>¿Depofibra entrega en España y Portugal?</summary>
            <div class="faq__answer">
              <p>Podemos estudiar suministros en España y Portugal según la referencia, el destino, el tamaño del producto y las condiciones del transporte. La viabilidad se confirma para cada solicitud.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       SECCIÓN 7 — CTA COMERCIAL FINAL
       ═══════════════════════════════════════════════ -->
  <section class="final-cta section" id="solicitar-presupuesto" aria-labelledby="final-cta-heading">
    <div class="container">
      <div class="final-cta__panel">
        <div class="final-cta__content">
          <span class="final-cta__eyebrow">Atención comercial desde Casariche (Sevilla)</span>
          <h2 class="final-cta__title" id="final-cta-heading">
            Pide presupuesto de tu depósito o producto PRFV
          </h2>
          <p class="final-cta__copy">
            Cuéntanos qué modelo o capacidad necesitas, para qué se utilizará y a qué localidad hay que entregarlo. Consultaremos las opciones y el transporte.
          </p>
        </div>
        <div class="final-cta__actions">
          <button class="btn btn--white open-quote-trigger" type="button">
            Solicitar presupuesto
            <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </button>
        </div>
