---
import { publishedCustomerReviews } from '../data/customerReviews';

const reviews = publishedCustomerReviews.filter((review) =>
  review.consentConfirmed === true &&
  review.sourceVerified === true &&
  review.author.trim().length > 0 &&
  review.text.trim().length > 0 &&
  review.sourceLabel.trim().length > 0
);
---

<section class="customer-reviews section" id="valoraciones" aria-labelledby="customer-reviews-heading">
  <div class="container customer-reviews__layout">
    <div class="customer-reviews__intro">
      <span class="eyebrow">OPINIONES DE CLIENTES</span>
      <h2 class="heading-lg" id="customer-reviews-heading">La confianza se construye con experiencias reales.</h2>
      <p class="body-lg">
        Queremos compartir cómo valoran nuestros clientes la atención y los productos de Depofibra.
        Mostraremos únicamente opiniones que podamos atribuir a una experiencia auténtica y publicar con autorización.
      </p>
    </div>

    <div class="customer-reviews__content">
      {reviews.length > 0 ? (
        <div class="customer-reviews__entries" aria-label="Opiniones de clientes publicadas">
          {reviews.map((review) => (
            <figure class="customer-reviews__entry">
              {review.rating && (
                <div class="customer-reviews__rating" aria-label={`${review.rating} de 5 estrellas`}>
                  {'★'.repeat(review.rating)}
                </div>
              )}
              <blockquote>«{review.text}»</blockquote>
              <figcaption>
                <strong>{review.author}</strong>
                <span>{review.date} · {review.sourceUrl ? (
                  <a href={review.sourceUrl} rel="nofollow noopener noreferrer" target="_blank">{review.sourceLabel}</a>
                ) : review.sourceLabel}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="customer-reviews__invitation">
          <span class="customer-reviews__symbol" aria-hidden="true">“</span>
          <h3>Tu experiencia también puede ayudar a otros.</h3>
          <p>
            Este espacio está reservado para opiniones de clientes con procedencia comprobable.
            Si has tenido una experiencia real con Depofibra, puedes compartirla directamente con nosotros.
          </p>
          <a href="mailto:depofibra21@gmail.com?subject=Mi%20experiencia%20con%20Depofibra" class="customer-reviews__link">
            Compartir mi experiencia <span aria-hidden="true">↗</span>
          </a>
          <small>Solo publicaremos una opinión con el permiso de su autor y los datos necesarios para atribuirla.</small>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .customer-reviews {
    background: #f7f9fc;
    border-top: 1px solid #e2e9f0;
    border-bottom: 1px solid #e2e9f0;
  }
  .customer-reviews__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: clamp(28px, 4vw, 64px);
  }
  .customer-reviews__intro h2 {
    max-width: 690px;
    margin: 14px 0 20px;
    text-wrap: balance;
  }
  .customer-reviews__intro p {
    max-width: 650px;
    margin: 0;
    color: var(--color-gray-600);
    line-height: 1.8;
  }
  .customer-reviews__invitation {
    padding: 24px 0 14px;
    border-top: 2px solid var(--color-primary);
  }
  .customer-reviews__symbol {
    display: block;
    height: 54px;
    color: #a6c4df;
    font: 800 85px/.9 Georgia, serif;
  }
  .customer-reviews__invitation h3 {
    max-width: 490px;
    margin: 10px 0 13px;
    color: var(--color-dark);
    font: 800 clamp(22px, 2.5vw, 32px)/1.22 var(--font-display);
    letter-spacing: -.035em;
  }
  .customer-reviews__invitation p {
    max-width: 560px;
    margin: 0 0 18px;
    color: var(--color-gray-600);
    line-height: 1.75;
    font-size: 15px;
  }
  .customer-reviews__link {
    display: inline-flex;
    gap: 13px;
    min-height: 44px;
    align-items: center;
    color: var(--color-primary);
    font: 750 14px/1.4 var(--font-display);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .customer-reviews__link:hover { color: var(--color-primary-dark); }
  .customer-reviews__link:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  .customer-reviews__invitation small {
    display: block;
    max-width: 560px;
    margin-top: 18px;
    color: var(--color-gray-500);
    font-size: 12px;
    line-height: 1.6;
  }
  .customer-reviews__entries { display: grid; gap: 24px; }
  .customer-reviews__entry {
    margin: 0;
    padding: 22px 0;
    border-top: 2px solid var(--color-primary);
  }
  .customer-reviews__rating { color: #01488e; letter-spacing: .08em; font-size: 17px; }
  .customer-reviews__entry blockquote {
    max-width: 58ch;
    margin: 14px 0 20px;
    color: var(--color-dark);
    font: 600 clamp(19px, 2vw, 25px)/1.5 var(--font-display);
  }
  .customer-reviews__entry figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
  .customer-reviews__entry figcaption strong { color: var(--color-dark); font-size: 14px; }
  .customer-reviews__entry figcaption span { color: var(--color-gray-600); font-size: 12px; }
  .customer-reviews__entry figcaption a { color: var(--color-primary); text-underline-offset: 3px; }
  @media (min-width: 920px) {
    .customer-reviews__layout { grid-template-columns: minmax(0, 1fr) minmax(0, .88fr); }
  }
  @media (max-width: 599px) {
    .customer-reviews__intro h2 { margin-bottom: 12px; }
    .customer-reviews__invitation { padding-top: 18px; }
  }
</style>
