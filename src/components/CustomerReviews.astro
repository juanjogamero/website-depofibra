---
import { publishedCustomerReviews } from '../data/customerReviews';

const reviews = publishedCustomerReviews.filter((review) =>
  review.consentConfirmed === true &&
  review.sourceVerified === true &&
  review.author.trim().length > 0 &&
  review.text.trim().length > 0 &&
  review.sourceLabel.trim().length > 0
);
const autoplayEligible = reviews.length >= 4;
const autoplayDuration = Math.max(38, reviews.length * 6);
---

<section class="customer-reviews section" id="valoraciones" aria-labelledby="customer-reviews-heading">
  <div class="container customer-reviews__intro">
    <span class="eyebrow">OPINIONES DE CLIENTES</span>
    <h2 class="heading-lg" id="customer-reviews-heading">Experiencias compartidas con Depofibra</h2>
    <p class="body-lg">
      Queremos que las valoraciones que aparezcan aquí reflejen experiencias auténticas,
      con procedencia comprobable y autorización de publicación.
    </p>
  </div>

  {reviews.length > 0 && (
    <div
      class="customer-reviews__rail"
      data-customer-reviews-rail
      data-autoplay-eligible={autoplayEligible ? 'true' : 'false'}
      style={'--review-duration: ' + autoplayDuration + 's'}
      role="region"
      aria-label="Valoraciones de clientes de Depofibra"
      tabindex="0"
    >
      <div class="customer-reviews__track" data-customer-reviews-track>
        <div class="customer-reviews__group" data-customer-reviews-group>
          {reviews.map((review) => (
            <figure class="customer-reviews__card">
              <div class="customer-reviews__card-top">
                <span class="customer-reviews__avatar" aria-hidden="true">{review.author.trim().charAt(0).toUpperCase()}</span>
                <span class="customer-reviews__author">{review.author}</span>
              </div>
              {review.rating && (
                <div class="customer-reviews__stars" aria-label={String(review.rating) + ' de 5 estrellas'}>
                  <span aria-hidden="true">{'★'.repeat(review.rating)}</span>
                </div>
              )}
              <blockquote>«{review.text}»</blockquote>
              <figcaption>
                <time datetime={review.date}>{review.date}</time>
                <span class="customer-reviews__source">
                  {review.sourceUrl ? (
                    <a href={review.sourceUrl} target="_blank" rel="nofollow noopener noreferrer">{review.sourceLabel}</a>
                  ) : review.sourceLabel}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="container customer-reviews__invitation">
    {reviews.length === 0 && (
      <div class="customer-reviews__empty">
        <span class="customer-reviews__symbol" aria-hidden="true">“</span>
        <h3>Tu experiencia también puede ayudar a otros.</h3>
        <p>Este espacio está reservado para opiniones de clientes con procedencia comprobable. Aún no mostramos testimonios publicados.</p>
      </div>
    )}
    <div class="customer-reviews__invitation-row">
      {reviews.length > 0 && (
        <p>¿Has comprado o realizado una consulta a Depofibra? Tu experiencia también puede ayudar a otros.</p>
      )}
      <a href="mailto:depofibra21@gmail.com?subject=Mi%20experiencia%20con%20Depofibra" class="customer-reviews__link">
        Compartir mi experiencia <span aria-hidden="true">↗</span>
      </a>
    </div>
    <small>Solo publicaremos una opinión con el permiso de su autor y los datos necesarios para atribuirla. Las estrellas se muestran únicamente cuando forman parte de una valoración real.</small>
  </div>
</section>

<script>
  // El HTML entregado a buscadores contiene cada reseña AUTÉNTICA una sola vez.
  // La copia para la animación se crea únicamente en el navegador, sin marcado SEO.
  for (const rail of document.querySelectorAll<HTMLElement>('[data-customer-reviews-rail]')) {
    if (rail.dataset.autoplayEligible !== 'true') continue;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    const track = rail.querySelector<HTMLElement>('[data-customer-reviews-track]');
    const group = rail.querySelector<HTMLElement>('[data-customer-reviews-group]');
    if (!track || !group) continue;

    const duplicate = group.cloneNode(true) as HTMLElement;
    duplicate.removeAttribute('data-customer-reviews-group');
    duplicate.setAttribute('aria-hidden', 'true');
    duplicate.inert = true;
    track.appendChild(duplicate);
    rail.classList.add('customer-reviews__rail--animated');
  }
</script>

<style>
  .customer-reviews { background: #f7f9fc; border-block: 1px solid #e2e9f0; overflow: hidden; }
  .customer-reviews__intro { max-width: 1120px; }
  .customer-reviews__intro h2 { max-width: 790px; margin: 14px 0 16px; text-wrap: balance; }
  .customer-reviews__intro p { max-width: 740px; margin: 0; color: var(--color-gray-600); line-height: 1.75; }

  .customer-reviews__rail {
    margin: 31px 0 0;
    overflow-x: auto;
    scrollbar-width: thin;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x proximity;
    outline-offset: 5px;
  }
  .customer-reviews__rail:focus-visible { outline: 2px solid var(--color-primary); }
  .customer-reviews__track { display: flex; width: max-content; }
  .customer-reviews__group { display: flex; flex: none; gap: 17px; padding-right: 17px; padding-left: 0; }
  .customer-reviews__group:first-child { padding-left: max(18px, calc((100vw - 1180px) / 2)); }

  .customer-reviews__card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    flex: 0 0 clamp(265px, 28vw, 350px);
    min-height: 258px;
    margin: 0;
    padding: 22px 23px;
    border-radius: 14px;
    border: 1px solid #dce6f0;
    background: #fff;
    box-shadow: 0 7px 23px rgba(0,45,89,.045);
    scroll-snap-align: start;
  }
  .customer-reviews__card-top { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .customer-reviews__avatar {
    width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center;
    border-radius: 50%; background: #eaf2fb; color: #01488e; font: 800 15px/1 var(--font-display);
  }
  .customer-reviews__author { color: var(--color-dark); font: 750 14px/1.35 var(--font-display); overflow-wrap: anywhere; }
  .customer-reviews__stars { margin: 14px 0 8px; color: #cf7a1d; letter-spacing: .065em; font-size: 17px; }
  .customer-reviews__card blockquote {
    margin: 5px 0 17px; color: #30465d; font-size: 14px; line-height: 1.65;
    display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden;
  }
  .customer-reviews__card figcaption {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 5px 10px;
    padding-top: 12px; margin-top: auto; border-top: 1px solid #e6edf4;
    font-size: 11px; line-height: 1.5; color: #65778a;
  }
  .customer-reviews__card figcaption a { color: #01488e; text-underline-offset: 3px; }

  .customer-reviews__invitation {
    margin-top: clamp(21px, 3vw, 35px);
    padding-top: 22px;
    border-top: 1px solid #dde6ef;
  }
  .customer-reviews__empty { max-width: 680px; }
  .customer-reviews__symbol { display: block; height: 49px; font: 800 80px/.9 Georgia,serif; color: #a6c4df; }
  .customer-reviews__empty h3 {
    margin: 10px 0 12px; color: var(--color-dark);
    font: 800 clamp(22px,2.4vw,31px)/1.2 var(--font-display); letter-spacing: -.03em;
  }
  .customer-reviews__empty p, .customer-reviews__invitation-row p {
    margin: 0; color: var(--color-gray-600); font-size: 14px; line-height: 1.7;
  }
  .customer-reviews__invitation-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 22px; }
  .customer-reviews__link {
    display: inline-flex; gap: 13px; min-height: 44px; align-items: center;
    color: var(--color-primary); font: 750 14px/1.4 var(--font-display);
    text-decoration: underline; text-underline-offset: 5px;
  }
  .customer-reviews__link:hover { color: var(--color-primary-dark); }
  .customer-reviews__link:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; }
  .customer-reviews__invitation small { display: block; max-width: 750px; margin-top: 12px; color: var(--color-gray-500); font-size: 12px; line-height: 1.6; }

  @media (prefers-reduced-motion: no-preference) {
    .customer-reviews__rail--animated { overflow: hidden; scroll-snap-type: none; }
    .customer-reviews__rail--animated .customer-reviews__track { animation: customer-reviews-scroll var(--review-duration, 70s) linear infinite; }
    .customer-reviews__rail--animated:hover .customer-reviews__track,
    .customer-reviews__rail--animated:focus-within .customer-reviews__track,
    .customer-reviews__rail--animated:active .customer-reviews__track { animation-play-state: paused; }
  }
  @keyframes customer-reviews-scroll { to { transform: translateX(-50%); } }
  @media (max-width: 599px) {
    .customer-reviews__rail { margin-top: 23px; }
    .customer-reviews__group { gap: 12px; padding-right: 12px; }
    .customer-reviews__card { flex-basis: min(79vw, 330px); min-height: 246px; padding: 19px; }
    .customer-reviews__invitation { margin-top: 21px; }
  }
</style>
