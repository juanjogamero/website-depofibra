---
import { publishedCustomerReviews } from '../data/customerReviews';

const reviews = publishedCustomerReviews.filter((review) => review.text.trim().length > 0);
---

<section class="customer-reviews section" id="valoraciones" aria-labelledby="customer-reviews-heading">
  <div class="container customer-reviews__head">
    <div>
      <span class="eyebrow">OPINIONES DE CLIENTES</span>
      <h2 class="heading-lg" id="customer-reviews-heading">Experiencias compartidas con Depofibra</h2>
      <p class="body-lg">Opiniones compartidas con Depofibra sobre la atención, la gestión y la entrega.</p>
    </div>
  </div>

  {reviews.length > 0 ? (
    <>
      <div class="customer-reviews__scroll-wrap">
        <div class="customer-reviews__rail" data-customer-reviews-rail role="region"
          aria-roledescription="carrusel horizontal"
          aria-label="Opiniones de clientes de Depofibra. Desliza horizontalmente"
          tabindex="0">
          <div class="customer-reviews__track">
            {reviews.map((review) => (
              <article class="customer-reviews__card">
                <div class="customer-reviews__card-head">
                  <div class="customer-reviews__avatar" aria-hidden="true">{(review.author || 'Cliente').trim().charAt(0).toUpperCase()}</div>
                  <div class="customer-reviews__identity">
                    <strong>{review.author || 'Cliente'}</strong>
                    <span>Opinión compartida con Depofibra</span>
                  </div>
                </div>
                {review.rating && (
                  <div class="customer-reviews__rating">
                    <span class="customer-reviews__stars" aria-label={String(review.rating) + ' estrellas de 5'}>
                      {'★'.repeat(review.rating)}
                    </span>
                  </div>
                )}
                <p class="customer-reviews__quote">«{review.text}»</p>
                {(review.date || review.sourceLabel) && (
                  <div class="customer-reviews__card-bottom">
                    {review.date && <time datetime={review.date}>{review.date}</time>}
                    {review.sourceLabel && <span>
                      {review.sourceUrl ? (
                        <a href={review.sourceUrl} rel="nofollow noopener noreferrer" target="_blank">{review.sourceLabel}</a>
                      ) : review.sourceLabel}
                    </span>}
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
      <div class="container customer-reviews__navigation">
        <p><span aria-hidden="true">↔</span> Desliza las opiniones o utiliza las flechas para recorrerlas.</p>
        <div class="customer-reviews__buttons">
          <button type="button" class="customer-reviews__arrow" data-reviews-prev aria-label="Ver opiniones anteriores">←</button>
          <button type="button" class="customer-reviews__arrow" data-reviews-next aria-label="Ver siguientes opiniones">→</button>
        </div>
      </div>
    </>
  ) : (
    <div class="container customer-reviews__empty">
      <p>Estamos reuniendo opiniones de clientes que podamos publicar con su autorización.</p>
    </div>
  )}

  <div class="container customer-reviews__invitation">
    <div>
      <h3>¿Has tenido una experiencia con Depofibra?</h3>
      <p>Queremos conocerla. Puedes compartirla directamente con nosotros.</p>
    </div>
    <a href="/opinar/" class="customer-reviews__link">Dejar una valoración <span aria-hidden="true">↗</span></a>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#valoraciones');
  if (section) {
    const rail = section.querySelector<HTMLElement>('[data-customer-reviews-rail]');
    const previous = section.querySelector<HTMLButtonElement>('[data-reviews-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-reviews-next]');
    if (rail && previous && next) {
      const update = () => {
        previous.disabled = rail.scrollLeft <= 3;
        next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 3;
      };
      const move = (direction: -1 | 1) => {
        const card = rail.querySelector<HTMLElement>('.customer-reviews__card');
        const step = card ? card.getBoundingClientRect().width + 16 : rail.clientWidth * 0.75;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        rail.scrollBy({ left: direction * step, behavior: reducedMotion ? 'instant' : 'smooth' });
      };
      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      rail.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    }
  }
</script>


<script type="module" is:inline>
  // Se añaden únicamente reseñas moderadas y aprobadas en Firestore.
  // No se permite HTML suministrado por usuarios: solo textContent.
  async function loadApprovedReviews() {
    const section = document.getElementById('valoraciones');
    if (!section) return;
    let config;
    try {
      const response = await fetch('/reviews/firebase-config.json');
      if (!response.ok) return;
      config = await response.json();
      if (!config.apiKey || !config.authDomain || !config.projectId || !config.appId) return;
      const [{initializeApp}, sdk] = await Promise.all([
        import('https://www.gstatic.com/firebasejs/13.4.0/firebase-app.js'),
        import('https://www.gstatic.com/firebasejs/13.4.0/firebase-firestore.js')
      ]);
      const app = initializeApp(config, 'depofibra-public-reviews');
      const db = sdk.getFirestore(app);
      const q = sdk.query(sdk.collection(db, 'customerReviews'), sdk.where('status','==','approved'), sdk.limit(30));
      const snapshot = await sdk.getDocs(q);
      if (snapshot.empty) return;
      let rail = section.querySelector('[data-customer-reviews-rail]');
      let track = section.querySelector('.customer-reviews__track');
      if (!track) {
        const wrap = document.createElement('div'); wrap.className = 'customer-reviews__scroll-wrap';
        rail = document.createElement('div'); rail.className = 'customer-reviews__rail'; rail.setAttribute('data-customer-reviews-rail','');
        rail.setAttribute('role','region'); rail.setAttribute('aria-label','Opiniones de clientes de Depofibra'); rail.tabIndex = 0;
        track = document.createElement('div'); track.className = 'customer-reviews__track';
        rail.append(track); wrap.append(rail);
        const head = section.querySelector('.customer-reviews__head');
        head.after(wrap);
        const empty = section.querySelector('.customer-reviews__empty'); if (empty) empty.hidden = true;
      }
      for (const record of snapshot.docs) {
        const review = record.data();
        if (!Number.isInteger(review.rating) || review.rating < 1 || review.rating > 5 ||
          typeof review.text !== 'string' || typeof review.author !== 'string') continue;
        const card = document.createElement('article'); card.className = 'customer-reviews__card';
        const cardHead = document.createElement('div'); cardHead.className = 'customer-reviews__card-head';
        const avatar = document.createElement('div'); avatar.className = 'customer-reviews__avatar'; avatar.setAttribute('aria-hidden','true');
        avatar.textContent = (review.author.trim() || 'C').charAt(0).toUpperCase();
        const identity = document.createElement('div'); identity.className = 'customer-reviews__identity';
        const name = document.createElement('strong'); name.textContent = review.author;
        const source = document.createElement('span'); source.textContent = 'Opinión enviada desde la web';
        identity.append(name, source); cardHead.append(avatar,identity);
        const rating = document.createElement('div'); rating.className = 'customer-reviews__rating';
        const stars = document.createElement('span'); stars.className = 'customer-reviews__stars';
        stars.textContent = '★'.repeat(review.rating); stars.setAttribute('aria-label', review.rating + ' estrellas de 5');
        rating.append(stars);
        const quote = document.createElement('p'); quote.className = 'customer-reviews__quote'; quote.textContent = '«' + review.text + '»';
        card.append(cardHead,rating,quote); track.append(card);
      }
    } catch (error) {
      // Fallo de red: conservar la sección estática, sin exponer datos al público.
      console.warn('Las opiniones online no están disponibles.');
    }
  }
  loadApprovedReviews();
</script>

<style>
  .customer-reviews { overflow: hidden; background: #f7f9fc; border-block: 1px solid #e1e9f2; }
  .customer-reviews__head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 18px 30px; }
  .customer-reviews__head h2 { max-width: 785px; margin: 14px 0 13px; text-wrap: balance; }
  .customer-reviews__head p { max-width: 745px; color: #576c81; margin: 0; line-height: 1.72; }
  .customer-reviews__count { display: flex; align-items: center; gap: 12px; color: #64778a; padding-bottom: 3px; }
  .customer-reviews__count strong { font: 800 32px/1 var(--font-display); color: #002d59; }
  .customer-reviews__count span { font: 600 12px/1.3 var(--font-body); max-width: 80px; }
  .customer-reviews__disclosure { margin: 22px 0 0; padding: 12px 15px; border-left: 3px solid #01488e; background: #eaf2fb; color: #324d69; font: 500 13px/1.65 var(--font-body); }
  .customer-reviews__disclosure strong { display: inline; font-weight: 800; }
  .customer-reviews__empty { margin-top: 20px; color: #5d7186; font: 400 14px/1.75 var(--font-body); }
  .customer-reviews__empty p { margin: 0; }
  .customer-reviews__scroll-wrap { position: relative; margin-top: 24px; }
  .customer-reviews__rail {
    overflow-x: auto; scrollbar-width: thin; scrollbar-color: #a9bfd4 transparent;
    scroll-snap-type: x mandatory; scroll-padding-inline: max(18px, calc((100vw - 1180px) / 2));
    overscroll-behavior-inline: contain; touch-action: pan-x;
    -webkit-overflow-scrolling: touch; outline-offset: 3px;
  }
  .customer-reviews__rail:focus-visible { outline: 2px solid #01488e; }
  .customer-reviews__track {
    display: flex; gap: 16px; width: max-content; padding: 5px max(18px, calc((100vw - 1180px) / 2)) 24px;
  }
  .customer-reviews__card {
    flex: 0 0 clamp(280px, 27vw, 340px); box-sizing: border-box; display: flex; flex-direction: column;
    min-height: 289px; margin: 0; padding: 20px 21px 16px; border: 1px solid #e2eaf2;
    border-radius: 14px; background: #fff; box-shadow: 0 7px 19px rgba(22,59,103,.055);
    scroll-snap-align: start;
  }
  .customer-reviews__card-head { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .customer-reviews__avatar {
    flex: 0 0 39px; width: 39px; height: 39px; display: grid; place-items: center;
    border-radius: 50%; background: #eaf2fb; color: #01488e; font: 800 13px/1 var(--font-display);
  }
  .customer-reviews__identity { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 4px; }
  .customer-reviews__identity strong { color: #20354c; font: 750 13px/1.4 var(--font-display); overflow-wrap: anywhere; }
  .customer-reviews__identity span { color: #74879a; font: 500 10px/1.4 var(--font-body); }
  .customer-reviews__rating { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin: 16px 0 11px; }
  .customer-reviews__stars { color: #db8b1a; font-size: 17px; letter-spacing: .055em; }
  .customer-reviews__category { font: 600 10px/1.2 var(--font-body); color: #526d87; border: 1px solid #e2eaf3; border-radius: 99px; padding: 4px 8px; background: #f8fbff; }
  .customer-reviews__quote { color: #3d526a; font: 400 13px/1.76 var(--font-body); margin: 0 0 16px; flex: 1; }
  .customer-reviews__card-bottom { border-top: 1px solid #edf1f6; padding-top: 12px; display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 7px; color: #77899d; font: 500 10px/1.5 var(--font-body); }
  .customer-reviews__card-bottom strong { font: 750 10px/1.5 var(--font-body); color: #975618; }
  .customer-reviews__card-bottom a { color: #01488e; text-underline-offset: 3px; }
  .customer-reviews__navigation { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
  .customer-reviews__navigation p { color: #63798f; font: 500 12px/1.6 var(--font-body); margin: 0; }
  .customer-reviews__buttons { display: flex; gap: 8px; }
  .customer-reviews__arrow {
    min-width: 42px; min-height: 42px; border: 1px solid #d6e2ee;
    border-radius: 9px; background: #fff; color: #002d59; font: 800 19px/1 var(--font-body); cursor: pointer;
  }
  .customer-reviews__arrow:hover:not(:disabled) { background: #eaf2fb; }
  .customer-reviews__arrow:focus-visible { outline: 2px solid #01488e; outline-offset: 3px; }
  .customer-reviews__arrow:disabled { opacity: .38; cursor: default; }
  .customer-reviews__invitation { margin-top: 29px; border-top: 1px solid #dbe5f0; padding-top: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px 25px; }
  .customer-reviews__invitation h3 { color: #002d59; font: 800 21px/1.3 var(--font-display); margin: 0 0 6px; }
  .customer-reviews__invitation p { color: #5d7186; font: 400 13px/1.65 var(--font-body); margin: 0; max-width: 670px; }
  .customer-reviews__link { display: inline-flex; align-items: center; gap: 12px; color: #01488e; font: 750 14px/1.4 var(--font-display); min-height: 44px; text-decoration: underline; text-underline-offset: 5px; }
  .customer-reviews__link:hover { color: #002d59; }
  .customer-reviews__link:focus-visible { outline: 2px solid #01488e; outline-offset: 3px; }
  @media (max-width: 699px) {
    .customer-reviews__scroll-wrap { margin-top: 18px; }
    .customer-reviews__card { flex-basis: min(83vw, 325px); padding: 18px; min-height: 285px; }
    .customer-reviews__track { gap: 12px; padding-inline: 18px; }
    .customer-reviews__navigation { margin-top: 8px; }
    .customer-reviews__invitation { margin-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .customer-reviews__rail { scroll-behavior: auto; } }
</style>

