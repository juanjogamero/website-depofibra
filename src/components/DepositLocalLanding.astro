---
/** Página comercial local: mercados respaldados por GSC y contexto de regadío documentado. */
import Layout from '../layouts/Layout.astro';
import type { DepositLocalLanding } from '../data/depositLocalLandings';

interface Props { landing: DepositLocalLanding }
const {landing} = Astro.props;
const canonical = `https://depofibra.com/depositos/${landing.slug}/`;
const heroPhoto = landing.heroImage.src;
const heroAlt = landing.heroImage.alt;
const regionNote = landing.quoteContext;
const isSevilla = landing.slug === 'sevilla';
const isGranjasArea = landing.slug === 'segovia' || landing.slug === 'huesca';
const applicationHref = isGranjasArea ? '/depositos/para-granjas/' : '/depositos/para-riego/';
const applicationLabel = isGranjasArea ? 'depósitos para granjas y explotaciones ganaderas' : 'depósitos para riego agrícola';
const applicationExplanation = isGranjasArea
  ? 'Si necesitas autonomía de agua en una explotación ganadera, revisa el consumo, el uso y la documentación del modelo.'
  : 'Si la reserva se destina a una finca de riego, calcula los litros entre reposiciones y comprueba el origen autorizado del agua.';
---
<Layout title={landing.seoTitle} description={landing.metaDescription} canonical={canonical} ogImage={heroPhoto} ogImageAlt={heroAlt} activeNav="depositos">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org',
      '@graph':[
        {'@type':'BreadcrumbList',itemListElement:[
          {'@type':'ListItem',position:1,name:'Inicio',item:'https://depofibra.com/'},
          {'@type':'ListItem',position:2,name:'Depósitos de poliéster',item:'https://depofibra.com/depositos/'},
          {'@type':'ListItem',position:3,name:landing.province,item:canonical},
        ]},
        {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:landing.h1,
          description:landing.metaDescription,inLanguage:'es-ES',
          isPartOf:{'@id':'https://depofibra.com/#website'},
          about:{'@id':'https://depofibra.com/#organization'},
          // Referencia territorial, sin simular sedes ni puntos físicos de Depofibra.
          spatialCoverage:{'@type':'AdministrativeArea',name:landing.province},
          citation:{'@type':'WebPage',name:landing.sourceName,url:landing.sourceUrl},
          primaryImageOfPage:{'@type':'ImageObject',url:new URL(heroPhoto,'https://depofibra.com').href,caption:heroAlt}}
      ]
    })} />
  </Fragment>

  <div class="dl-page">
    <div class="container">
      <nav class="dl-breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/depositos/">Depósitos</a><span aria-hidden="true">/</span>
        <span aria-current="page">{landing.province}</span>
      </nav>

      <header class="dl-intro">
        <div class="dl-intro__copy">
          <span class="eyebrow">{landing.eyebrow}</span>
          <h1>{landing.h1}</h1>
          <p class="dl-lead">{landing.lead}</p>
          <p class="dl-range">Depósitos de <strong>100 a 60.000 litros</strong> según familia y modelo. Consúltanos la capacidad que necesitas.</p>
          <p class="dl-disclaimer">{isSevilla ? "Depofibra atiende desde Casariche, en la provincia de Sevilla, y comercializa depósitos de fabricantes externos. No anunciamos fábrica, almacén, visita comercial o transporte propios; cada suministro se confirma según modelo y destino." : `Depofibra comercializa depósitos de fabricantes externos desde Casariche (Sevilla). No tenemos fábrica ni sede en ${landing.province}; las condiciones de suministro se confirman según modelo y dirección de entrega.`}</p>
          <div class="dl-actions">
            <button type="button" class="btn btn--primary open-quote-trigger" data-product="Depósito" data-note={regionNote}>Solicitar presupuesto</button>
            <a class="dl-text-link" href={landing.heroImage.productHref}>{landing.heroImage.productLabel} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <figure class="dl-photo">
          <img src={heroPhoto} alt={heroAlt} width="670" height="630" loading="eager" fetchpriority="high" />
          <figcaption>Imagen de una referencia del catálogo. Equipamiento y dimensiones según modelo, no fotografía de una entrega en {landing.province}.</figcaption>
        </figure>
      </header>
    </div>

    <section class="dl-section dl-section--soft" aria-labelledby="dl-region-heading">
      <div class="container dl-split">
        <div>
          <span class="eyebrow">NECESIDAD DE ALMACENAMIENTO</span>
          <h2 id="dl-region-heading">{landing.regionHeading}</h2>
        </div>
        <div class="dl-prose">
          {landing.regionParagraphs.map(paragraph => <p>{paragraph}</p>)}
          <p class="dl-source">Contexto territorial: <a href={landing.sourceUrl} rel="noopener noreferrer" target="_blank">{landing.sourceName}</a>. No es una medición de ventas ni de demanda de depósitos concretos.</p>
        </div>
      </div>
    </section>

    <section class="dl-section" aria-labelledby="dl-places-heading">
      <div class="container dl-split">
        <div>
          <span class="eyebrow">SEGÚN EL DESTINO</span>
          <h2 id="dl-places-heading">{landing.zoneHeading}</h2>
          <p class="dl-subnote">Son ejemplos de situaciones que conviene revisar, no puntos de venta, rutas de reparto garantizadas ni instalaciones realizadas por Depofibra.</p>
        </div>
        <div class="dl-guide-list">
          {landing.localCases.map((item,index)=><article class="dl-guide-row">
            <span class="dl-num">{String(index+1).padStart(2,'0')}</span>
            <div><h3>{item.place}</h3><p>{item.need}</p></div>
          </article>)}
        </div>
      </div>
    </section>

    <section class="dl-section dl-section--soft" aria-labelledby="dl-capacity-heading">
      <div class="container">
        <span class="eyebrow">CAPACIDADES Y TIPOS DE DEPÓSITOS</span>
        <h2 id="dl-capacity-heading">{landing.choiceHeading}</h2>
        <p class="dl-subnote">Trabajamos con capacidades desde <strong>100 hasta 60.000 litros</strong>, según la familia, el modelo y el uso. No todas las capacidades están disponibles en todos los formatos: confirmamos medidas, equipamiento y compatibilidad antes de presupuestar.</p>
        <nav aria-label="Familias de depósitos de poliéster">
          <ul class="dl-family-list">
            <li><a href="/depositos/vertical-base-plana/">Verticales de base plana <span aria-hidden="true">↗</span></a></li>
            <li><a href="/depositos/horizontal-con-cunas/">Horizontales con cunas <span aria-hidden="true">↗</span></a></li>
            <li><a href="/depositos/horizontal-enterrable/">Horizontales enterrables <span aria-hidden="true">↗</span></a></li>
            <li><a href="/depositos/vertical-con-patas/">Verticales con patas <span aria-hidden="true">↗</span></a></li>
            <li><a href="/depositos/tipo-vaso/">Depósitos tipo vaso <span aria-hidden="true">↗</span></a></li>
            <li><a href="/depositos/cuadrados-rectangulares/">Cuadrados y rectangulares <span aria-hidden="true">↗</span></a></li>
          </ul>
        </nav>
        <div class="dl-volume-links" aria-labelledby="dl-volume-links-heading">
          <h3 id="dl-volume-links-heading">Comparar depósitos verticales de 5.000, 10.000 y 15.000 litros</h3>
          <p class="dl-volume-links__intro">Estas fichas de base plana ayudan a estudiar el volumen de reserva para una finca o instalación en {landing.province}. No son ofertas cerradas ni confirman disponibilidad, dimensiones definitivas o entrega.</p>
          <ul class="dl-volume-links__list">
            {landing.capacityNotes.map(item => (
              <li>
                <a href={`/depositos/vertical-base-plana/${item.liters}-litros/`}>
                  Depósito vertical de {item.liters === 5000 ? '5.000' : item.liters.toLocaleString('es-ES')} litros <span aria-hidden="true">↗</span>
                </a>
                <p>{item.note}</p>
              </li>
            ))}
          </ul>
        </div>
        <p class="dl-secondary-links">Consulta el <a href="/depositos/">catálogo completo de formatos</a> o la <a href="/blog/calcular-capacidad-deposito-agua-riego/">guía para calcular la reserva de agua</a>. Indícanos los litros que necesitas, el uso y el código postal para estudiar la referencia y el transporte.</p>
        <p class="dl-secondary-links">¿Buscas una solución para tu actividad? Consulta nuestros <a href={applicationHref}>{applicationLabel}</a>. {applicationExplanation} La viabilidad de entrega en {landing.province} se confirma según referencia y código postal.</p>
      </div>
    </section>

    <section class="dl-section" aria-labelledby="dl-logistics-heading">
      <div class="container dl-split">
        <div>
          <span class="eyebrow">ANTES DE COTIZAR</span>
          <h2 id="dl-logistics-heading">{landing.logisticsHeading}</h2>
        </div>
        <div class="dl-prose">
          {landing.logisticsParagraphs.map(paragraph => <p>{paragraph}</p>)}
          <h3>Información suficiente para empezar</h3>
          <ul>
            <li>Uso previsto y capacidad aproximada.</li>
            <li>Municipio, código postal y características de acceso.</li>
            <li>Instalación en superficie o necesidad de modelo enterrable.</li>
            <li>Conexiones y medios previstos para la descarga.</li>
          </ul>
          <button type="button" class="btn btn--primary open-quote-trigger" data-product="Depósito" data-note={regionNote}>Consultar transporte y presupuesto</button>
        </div>
      </div>
    </section>

    <section class="dl-section dl-section--soft" aria-labelledby="dl-faq-heading">
      <div class="container dl-split">
        <div>
          <span class="eyebrow">PREGUNTAS FRECUENTES</span>
          <h2 id="dl-faq-heading">Dudas al comprar un depósito para {landing.province}</h2>
        </div>
        <div class="dl-faq">
          {landing.faq.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}
        </div>
      </div>
    </section>
  </div>
</Layout>
<style>
  .dl-page{color:var(--color-dark);background:#fff}
  .dl-breadcrumb{display:flex;flex-wrap:wrap;gap:9px;padding:22px 0 0;color:var(--color-gray-600);font:600 12px/1.5 var(--font-body)}
  .dl-breadcrumb a{color:var(--color-primary);text-decoration:underline;text-underline-offset:3px}
  .dl-intro{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);gap:clamp(28px,5vw,72px);align-items:center;padding:clamp(34px,6vw,82px) 0 clamp(56px,7vw,95px)}
  .dl-intro h1{font:800 clamp(34px,5.1vw,59px)/1.1 var(--font-display);letter-spacing:-.05em;color:var(--color-primary-dark);margin:14px 0 22px}
  .dl-range{margin-top:14px;font:600 15px/1.6 var(--font-body);color:var(--color-primary-dark)}
  .dl-lead{max-width:690px;font:400 clamp(16px,1.5vw,19px)/1.65 var(--font-body);color:var(--color-gray-700)}
  .dl-disclaimer{max-width:620px;margin-top:19px;font:400 13px/1.7 var(--font-body);color:var(--color-gray-600)}
  .dl-actions{display:flex;flex-wrap:wrap;align-items:center;gap:15px 24px;margin-top:28px}
  .dl-text-link,.dl-capacity a,.dl-secondary-links a,.dl-source a{color:var(--color-primary);font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .dl-photo{margin:0}
  .dl-photo img{width:100%;height:auto;max-height:485px;object-fit:contain}
  .dl-photo figcaption{font:400 11px/1.55 var(--font-body);color:var(--color-gray-600);margin-top:10px}
  .dl-section{padding:clamp(50px,6vw,85px) 0;border-top:1px solid var(--color-gray-200)}
  .dl-section--soft{background:var(--color-gray-50)}
  .dl-section h2{font:800 clamp(25px,3vw,38px)/1.15 var(--font-display);letter-spacing:-.035em;color:var(--color-primary-dark);margin:13px 0 20px;max-width:640px}
  .dl-split{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(30px,6vw,88px)}
  .dl-prose p,.dl-guide-row p,.dl-capacity p,.dl-faq p,.dl-subnote,.dl-secondary-links{font:400 15px/1.75 var(--font-body);color:var(--color-gray-600)}
  .dl-prose p+p{margin-top:18px}
  .dl-prose h3{font:800 17px/1.3 var(--font-display);color:var(--color-primary-dark);margin:24px 0 10px}
  .dl-prose ul{list-style:disc;padding-left:23px;margin:12px 0 25px}
  .dl-prose li{font:400 15px/1.7 var(--font-body);color:var(--color-gray-600);margin-bottom:7px}
  .dl-source{font-size:13px!important;border-top:1px solid var(--color-gray-200);padding-top:16px;margin-top:24px!important}
  .dl-subnote{max-width:850px;margin:0 0 27px}
  .dl-guide-list{border-top:1px solid var(--color-gray-200)}
  .dl-guide-row{display:grid;grid-template-columns:33px minmax(0,1fr);gap:15px;padding:20px 0;border-bottom:1px solid var(--color-gray-200)}
  .dl-num{font:800 12px/1.6 var(--font-display);color:var(--color-primary)}
  .dl-guide-row h3{font:800 16px/1.35 var(--font-display);color:var(--color-primary-dark);margin-bottom:7px}
  .dl-family-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 30px;margin:27px 0 30px;padding:0;list-style:none;border-top:1px solid var(--color-gray-200)}
  .dl-family-list li{border-bottom:1px solid var(--color-gray-200)}
  .dl-family-list a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px 0;font:700 15px/1.5 var(--font-body);color:var(--color-primary);text-decoration:none}
  .dl-family-list a:hover{text-decoration:underline;text-underline-offset:4px}
  .dl-family-list a span{font-size:13px}
  /* Fichas por capacidad: enlaces semánticos y texto útil, sin fotos o tarjetas nuevas. */
  .dl-volume-links{margin:7px 0 28px;padding-top:25px;border-top:1px solid var(--color-gray-200)}
  .dl-volume-links h3{font:800 clamp(18px,2vw,22px)/1.35 var(--font-display);letter-spacing:-.02em;color:var(--color-primary-dark);margin:0 0 10px}
  .dl-volume-links__intro{max-width:790px;margin:0 0 19px;font:400 14px/1.7 var(--font-body);color:var(--color-gray-600)}
  .dl-volume-links__list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(18px,2.6vw,30px)}
  .dl-volume-links__list li{padding:14px 0 0;border-top:2px solid #a7c6e2;min-width:0}
  .dl-volume-links__list a{font:750 15px/1.5 var(--font-display);color:var(--color-primary);text-decoration:underline;text-underline-offset:3px}
  .dl-volume-links__list a:hover{color:var(--color-primary-dark)}
  .dl-volume-links__list p{margin:9px 0 0;font:400 13px/1.65 var(--font-body);color:var(--color-gray-600)}
  @media(max-width:760px){.dl-volume-links__list{grid-template-columns:1fr;gap:17px}}
  .dl-secondary-links{padding-top:16px;border-top:1px solid var(--color-gray-200)}
  .dl-faq{border-top:1px solid var(--color-gray-200)}
  .dl-faq details{border-bottom:1px solid var(--color-gray-200)}
  .dl-faq summary{cursor:pointer;color:var(--color-primary-dark);font:700 15px/1.5 var(--font-body);padding:19px 0}
  .dl-faq details p{margin:0 0 19px}
  .dl-page a:focus-visible,.dl-page button:focus-visible{outline:3px solid #79b5ef;outline-offset:3px}
  @media(max-width:820px){.dl-intro,.dl-split{grid-template-columns:1fr}.dl-intro{gap:27px}.dl-photo{max-width:480px}}
  @media(max-width:570px){.dl-family-list{grid-template-columns:1fr}.dl-section{padding:43px 0}}
</style>
