---
/**
 * DEPOFIBRA · Aviso compacto de cookies + GA4 (v0.10.2).
 * Modo de consentimiento BÁSICO: NO se descarga Google Tag Manager ni GA4
 * antes de una decisión positiva de analítica. Rechazo y ausencia de elección
 * implican cero carga de scripts de Google de medición.
 * No se remiten preferencias al VPS; permanecen en localStorage.
 * No se envían datos de formularios, teléfono o correo a GA4.
 */
---

<section class="dfcc" id="dfcc-banner" aria-labelledby="dfcc-title" hidden>
  <div class="dfcc__main">
    <div class="dfcc__copy">
      <h2 id="dfcc-title">Cookies y privacidad</h2>
      <p>
        Google Analytics solo se activa si aceptas. Guardamos tu elección en este navegador.
        <a href="/politica-de-cookies/">Ver política</a>
      </p>
    </div>
    <div class="dfcc__actions" aria-label="Opciones de cookies">
      <button type="button" class="dfcc__decision" id="dfcc-reject">Rechazar</button>
      <button type="button" class="dfcc__decision" id="dfcc-accept">Aceptar</button>
      <button type="button" class="dfcc__configure" id="dfcc-customize" aria-controls="dfcc-options" aria-expanded="false">Personalizar</button>
    </div>
  </div>

  <div class="dfcc__details" id="dfcc-options" hidden>
    <div class="dfcc__category">
      <div>
        <strong>Almacenamiento necesario</strong>
        <span>Conserva la elección de cookies en este navegador.</span>
      </div>
      <span class="dfcc__permanent">Siempre activo</span>
    </div>
    <label class="dfcc__category" for="dfcc-analytics">
      <div>
        <strong>Preferencia de analítica</strong>
        <span>Google Analytics: páginas visitadas y uso general de la web, solo si aceptas. No enviamos los datos que escribas en formularios.</span>
      </div>
      <input id="dfcc-analytics" type="checkbox" aria-label="Guardar preferencia sobre estadísticas futuras" />
    </label>
    <div class="dfcc__detail-bottom">
      <p>Rechazar bloquea la analítica. Puedes cambiar tu elección desde el pie de página.</p>
      <button type="button" class="dfcc__save" id="dfcc-save">Guardar elección</button>
    </div>
  </div>
</section>

<style>
  .dfcc[hidden], .dfcc__details[hidden] { display:none !important; }
  .dfcc {
    position:fixed;
    z-index:11000;
    bottom:16px;
    left:16px;
    right:16px;
    width:min(980px,calc(100vw - 32px));
    margin:0 auto;
    max-height:min(80vh,calc(100dvh - 32px));
    overflow-y:auto;
    border:1px solid #cbdbe9;
    border-radius:13px;
    background:#fff;
    color:#17324e;
    box-shadow:0 6px 24px rgba(0,38,76,.15);
    font-family:Inter,Arial,sans-serif;
  }
  .dfcc__main {
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:20px;
    align-items:center;
    padding:12px 17px;
  }
  .dfcc__copy { min-width:0; }
  .dfcc h2 {
    margin:0 0 3px;
    font:750 13px/1.35 'Plus Jakarta Sans',Inter,Arial,sans-serif;
    letter-spacing:-.025em;
    color:#002d59;
  }
  .dfcc__copy p {
    margin:0;
    color:#526a80;
    font-size:11.5px;
    line-height:1.45;
  }
  .dfcc a { color:#01488e; font-weight:700; text-underline-offset:2px; white-space:nowrap; }
  .dfcc__actions { display:flex; align-items:center; gap:8px; flex-wrap:nowrap; }
  .dfcc button { cursor:pointer; font-family:Inter,Arial,sans-serif; }
  .dfcc__decision {
    flex:none;
    min-width:87px;
    min-height:40px;
    padding:8px 12px;
    background:#01488e;
    color:#fff;
    border:1px solid #01488e;
    border-radius:7px;
    font-size:12px;
    font-weight:700;
    line-height:1.25;
  }
  .dfcc__decision:hover { background:#002d59; border-color:#002d59; }
  .dfcc__configure {
    min-height:40px;
    padding:8px 6px;
    color:#01488e;
    background:transparent;
    border:1px solid transparent;
    font-size:12px;
    line-height:1.25;
    font-weight:700;
    text-decoration:underline;
    text-underline-offset:3px;
  }
  .dfcc__configure:hover { color:#002d59; }
  .dfcc__details { border-top:1px solid #e2eaf2; padding:7px 17px 13px; }
  .dfcc__category {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:9px 0;
  }
  .dfcc__category + .dfcc__category { border-top:1px solid #edf1f5; }
  .dfcc__category > div { display:flex; flex-direction:column; gap:3px; }
  .dfcc__category strong { color:#002d59; font-size:12px; font-weight:700; }
  .dfcc__category span { color:#61778c; font-size:11px; line-height:1.45; }
  .dfcc__permanent { white-space:nowrap; font-size:11px; }
  .dfcc__category input { width:19px; height:19px; flex:none; accent-color:#01488e; }
  .dfcc__detail-bottom { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:5px; }
  .dfcc__detail-bottom p { margin:0; color:#61778c; font-size:11px; line-height:1.4; }
  .dfcc__save {
    flex:none;
    padding:9px 14px;
    border:1px solid #01488e;
    border-radius:7px;
    background:#eaf2fb;
    color:#002d59;
    font-size:12px;
    font-weight:700;
    min-height:40px;
  }
  .dfcc button:focus-visible,.dfcc a:focus-visible,.dfcc input:focus-visible,
  :global(.dfcc-footer-link:focus-visible) { outline:3px solid #65b8f0; outline-offset:2px; }
  :global(.dfcc-footer-link) {
    background:transparent;
    color:inherit;
    border:0;
    margin:0;
    padding:0;
    font:inherit;
    cursor:pointer;
    text-decoration:underline;
    text-underline-offset:3px;
  }
  @media (max-width:740px) {
    .dfcc {
      bottom:calc(var(--bottom-nav-height, 76px) + env(safe-area-inset-bottom,0px) + 9px);
      left:10px;
      right:10px;
      width:calc(100vw - 20px);
      max-height:calc(100dvh - var(--bottom-nav-height, 76px) - env(safe-area-inset-bottom,0px) - 30px);
      border-radius:12px;
    }
    .dfcc__main { display:flex; flex-direction:column; align-items:stretch; gap:10px; padding:12px; }
    .dfcc h2 { font-size:12.5px; margin-bottom:3px; }
    .dfcc__copy p { font-size:11px; line-height:1.45; }
    .dfcc__actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px; width:100%; }
    .dfcc__decision { min-width:0; width:100%; padding:8px 5px; font-size:12px; min-height:41px; }
    .dfcc__configure { min-width:0; padding:8px 2px; font-size:11.5px; min-height:41px; }
    .dfcc__details { padding:6px 12px 12px; }
    .dfcc__detail-bottom { flex-wrap:wrap; }
    .dfcc__save { margin-left:auto; }
  }
  @media (prefers-reduced-motion:reduce) {
    .dfcc { scroll-behavior:auto; }
  }
</style>

<script>
  // NUEVA FINALIDAD real: se invalida el consentimiento antiguo, que solo
  // guardaba preferencias futuras sin seguimiento. Todos deben elegir de nuevo.
  const CONSENT_VERSION = 'depofibra-cookies-v2-ga4-consent';
  const STORAGE_KEY = 'depofibra-cookie-preferences';

  interface CookieChoice { version:string; necessary:true; analytics:boolean; savedAt:string; }
  const banner = document.getElementById('dfcc-banner');
  const options = document.getElementById('dfcc-options');
  const analyticsBox = document.getElementById('dfcc-analytics') as HTMLInputElement | null;
  const customize = document.getElementById('dfcc-customize');
  const saveBtn = document.getElementById('dfcc-save');
  const rejectBtn = document.getElementById('dfcc-reject');
  const acceptBtn = document.getElementById('dfcc-accept');
  let reopenedByFooter = false;
  let gtmLoaded = false;
  let googleScriptsWereLoaded = false;

  // Solo cargar el contenedor tras consentimiento positivo explícito.
  // No se añade iframe noscript ni script global en Layout.astro.
  function enableMeasurement() {
    if (gtmLoaded) return;
    gtmLoaded = true;
    googleScriptsWereLoaded = true;
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-KQQZDF6P';
    document.head.appendChild(s);
  }

  function pushEvent(name: string) {
    if (!gtmLoaded) return;
    (window as any).dataLayer?.push({event:name});
  }

  // Eventos sin información personal. Clicks = intención, NO clientes potenciales confirmados.
  document.addEventListener('click', (event) => {
    if (!gtmLoaded) return;
    const target = event.target as Element | null;
    if (!(target instanceof Element)) return;
    const a = target.closest('a[href]') as HTMLAnchorElement | null;
    if (a) {
      const url = a.getAttribute('href') || '';
      if (/^tel:/i.test(url)) pushEvent('contact_phone');
      else if (/whatsapp\.com|wa\.me/i.test(url)) pushEvent('contact_whatsapp');
    }
    if (target.closest('.open-quote-trigger')) pushEvent('quote_form_open');
  }, true);
  document.addEventListener('submit', (event) => {
    if (!gtmLoaded) return;
    const form = event.target;
    if (form instanceof HTMLFormElement && form.checkValidity() &&
        (form.id === 'quoteForm' || /formsubmit\.co/.test(form.action))) {
      // Intento de envío, no contabilizar como solicitud confirmada.
      pushEvent('quote_form_submit_attempt');
    }
  }, true);

  function currentChoice(): CookieChoice | null {
    try {
      const item = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      if (item && item.version === CONSENT_VERSION && typeof item.analytics === 'boolean') return item;
    } catch { /* Si localStorage no está disponible, se volverá a preguntar en otra visita */ }
    return null;
  }

  function announce(choice:CookieChoice | null) {
    // Evento local disponible para futuros servicios, SIN cargar trackers.
    window.dispatchEvent(new CustomEvent('depofibra:consent', {
      detail:{necessary:true,analytics:choice?.analytics === true,consentVersion:CONSENT_VERSION}
    }));
  }

  function collapseOptions() {
    if (options) options.hidden = true;
    customize?.setAttribute('aria-expanded','false');
  }

  function hideBanner() {
    if (banner) banner.hidden = true;
    collapseOptions();
    if (reopenedByFooter) {
      document.querySelector<HTMLElement>('.dfcc-footer-link')?.focus({preventScroll:true});
      reopenedByFooter = false;
    }
  }

  function storeChoice(analytics:boolean) {
    const choice:CookieChoice = {version:CONSENT_VERSION,necessary:true,analytics,savedAt:new Date().toISOString()};
    try { localStorage.setItem(STORAGE_KEY,JSON.stringify(choice)); } catch { /* Sin almacenamiento el sitio funciona igualmente */ }
    announce(choice);
    hideBanner();
    if (analytics) enableMeasurement();
    else if (googleScriptsWereLoaded) {
      // Después de revocar consentimiento, descargar una página limpia para
      // interrumpir las etiquetas ya cargadas (no es posible desinyectar GTM).
      window.location.reload();
    }
  }

  function showBanner(openDetails=false) {
    if (!banner) return;
    banner.hidden = false;
    if (analyticsBox) analyticsBox.checked = currentChoice()?.analytics === true;
    if (options) options.hidden = !openDetails;
    customize?.setAttribute('aria-expanded',String(openDetails));
  }

  // Acceso permanente y discreto desde el pie de página ya aprobado.
  const footerNav = document.querySelector('footer nav[aria-label="Información legal"]');
  if (footerNav && !footerNav.querySelector('.dfcc-footer-link')) {
    const control = document.createElement('button');
    control.type = 'button';
    control.className = 'dfcc-footer-link';
    control.textContent = 'Configurar cookies';
    control.addEventListener('click', () => {
      reopenedByFooter = true;
      showBanner(true);
      customize?.focus({preventScroll:true});
    });
    footerNav.appendChild(control);
  }

  rejectBtn?.addEventListener('click',()=>storeChoice(false));
  acceptBtn?.addEventListener('click',()=>storeChoice(true));
  customize?.addEventListener('click',()=>{
    if (!options) return;
    const open = options.hidden;
    options.hidden = !open;
    customize.setAttribute('aria-expanded',String(open));
    if (open) analyticsBox?.focus({preventScroll:true});
  });
  saveBtn?.addEventListener('click',()=>storeChoice(analyticsBox?.checked===true));

  window.addEventListener('keydown',(event)=>{
    if (event.key==='Escape' && banner && !banner.hidden && currentChoice()) hideBanner();
  });

  const initial = currentChoice();
  if (initial) {
    announce(initial);
    if (initial.analytics) enableMeasurement();
  } else { announce(null); showBanner(false); }
</script>
