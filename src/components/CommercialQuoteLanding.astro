---
/**
 * Landing comercial de intención transaccional. No simula tienda, PVP,
 * disponibilidad, fotos de unidades concretas ni certificados de producto.
 * Reutiliza Layout y el modal comercial vigente.
 */
import Layout from '../layouts/Layout.astro';

interface Option {
  name: string;
  href: string;
  detail: string;
  quoteProduct: string;
  quoteNote: string;
}
interface Step { title: string; detail: string }
interface FAQ { question: string; answer: string }
interface Props {
  canonicalPath: string;
  seoTitle: string;
  metaDescription: string;
  eyebrow: string;
  h1: string;
  introduction: string;
  quoteProduct: string;
  quoteNote: string;
  optionsTitle: string;
  optionsIntro: string;
  options: Option[];
  guideTitle: string;
  guideIntro: string;
  steps: Step[];
  faqs: FAQ[];
  related: { title: string; href: string; detail: string }[];
}
const page = Astro.props;
const canonical = `https://depofibra.com${page.canonicalPath}`;
const site = Astro.site?.origin ?? 'https://depofibra.com';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: page.h1,
      description: page.metaDescription,
      inLanguage: 'es-ES',
      isPartOf: { '@id': 'https://depofibra.com/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: 'Depósitos de poliéster', item: new URL('/depositos/', site).href },
        { '@type': 'ListItem', position: 3, name: page.h1, item: canonical },
      ],
    },
  ],
};
---
<Layout title={page.seoTitle} description={page.metaDescription} canonical={canonical} activeNav="depositos">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <main class="purchase-page">
    <section class="purchase-hero" aria-labelledby="purchase-title">
      <div class="purchase-container">
        <nav class="purchase-breadcrumb" aria-label="Migas de pan">
          <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/depositos/">Depósitos</a><span aria-hidden="true">/</span><span aria-current="page">{page.h1}</span>
        </nav>
        <p class="purchase-eyebrow">{page.eyebrow}</p>
        <h1 id="purchase-title">{page.h1}</h1>
        <p class="purchase-lead">{page.introduction}</p>
        <div class="purchase-actions">
          <button type="button" class="purchase-primary open-quote-trigger" data-product={page.quoteProduct} data-note={page.quoteNote}>Pedir presupuesto <span aria-hidden="true">↗</span></button>
          <a href="/contacto/" class="purchase-secondary">Ver otras formas de contacto</a>
        </div>
        <p class="purchase-note">Depofibra comercializa depósitos PRFV de fabricantes externos. Modelo, condiciones, precio y transporte se verifican antes de ofrecer una propuesta. La descarga no está incluida en el transporte estándar.</p>
      </div>
    </section>

    <section class="purchase-section purchase-options" aria-labelledby="purchase-options-title">
      <div class="purchase-container">
        <div class="purchase-heading">
          <p class="purchase-eyebrow">ELIGE UNA REFERENCIA</p>
          <h2 id="purchase-options-title">{page.optionsTitle}</h2>
          <p>{page.optionsIntro}</p>
        </div>
        <div class="purchase-option-list">
          {page.options.map((option) => (
            <article class="purchase-option">
              <div>
                <h3><a href={option.href}>{option.name} <span aria-hidden="true">↗</span></a></h3>
                <p>{option.detail}</p>
              </div>
              <button type="button" class="purchase-option-quote open-quote-trigger" data-product={option.quoteProduct} data-note={option.quoteNote}>Solicitar precio <span aria-hidden="true">↗</span></button>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="purchase-section purchase-guide" aria-labelledby="purchase-guide-title">
      <div class="purchase-container purchase-guide-layout">
        <div class="purchase-heading">
          <p class="purchase-eyebrow">ANTES DE PEDIR PRECIO</p>
          <h2 id="purchase-guide-title">{page.guideTitle}</h2>
          <p>{page.guideIntro}</p>
        </div>
        <ol class="purchase-steps">
          {page.steps.map((step, index) => (
            <li>
              <span class="purchase-step-number">{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{step.title}</h3><p>{step.detail}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="purchase-section" aria-labelledby="purchase-faq-title">
      <div class="purchase-container purchase-guide-layout">
        <div class="purchase-heading">
          <p class="purchase-eyebrow">RESPUESTAS CLARAS</p>
          <h2 id="purchase-faq-title">Preguntas antes de comprar</h2>
          <p>Condiciones que conviene aclarar antes de encargar un depósito y organizar la entrega.</p>
        </div>
        <div class="purchase-faqs">
          {page.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="purchase-related" aria-labelledby="purchase-related-title">
      <div class="purchase-container">
        <h2 id="purchase-related-title">También puede interesarte</h2>
        <div class="purchase-related-list">
          {page.related.map((item) => (
            <a href={item.href}>
              <strong>{item.title} <span aria-hidden="true">↗</span></strong><small>{item.detail}</small>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="purchase-bottom" aria-labelledby="purchase-bottom-title">
      <div class="purchase-container purchase-bottom-layout">
        <div>
          <p class="purchase-eyebrow">PRESUPUESTO SEGÚN TU INSTALACIÓN</p>
          <h2 id="purchase-bottom-title">Pide una propuesta de producto y transporte.</h2>
          <p>Indica capacidad aproximada, uso y código postal. Si tienes limitaciones de acceso o descarga, coméntalas para estudiar una opción viable.</p>
        </div>
        <button type="button" class="purchase-primary open-quote-trigger" data-product={page.quoteProduct} data-note={page.quoteNote}>Solicitar precio <span aria-hidden="true">↗</span></button>
      </div>
    </section>
  </main>
</Layout>

<style>
  .purchase-page{color:#19334f;background:#fff;font-family:var(--font-body,Inter,sans-serif)}
  .purchase-container{width:min(1120px,calc(100% - 40px));margin:0 auto}
  .purchase-hero{padding:27px 0 clamp(48px,6vw,86px);background:#fff}
  .purchase-breadcrumb{display:flex;gap:9px;align-items:center;flex-wrap:wrap;font-size:12px;color:#687c91;margin-bottom:clamp(36px,6vw,75px)}
  .purchase-breadcrumb a{color:#01488e;text-decoration:none}.purchase-breadcrumb a:hover{text-decoration:underline}
  .purchase-breadcrumb [aria-current]{max-width:100%;font-size:12px}
  .purchase-eyebrow{font:750 11px/1.5 var(--font-display,'Plus Jakarta Sans',sans-serif);color:#01488e;letter-spacing:.09em;text-transform:uppercase;margin:0 0 14px}
  .purchase-hero h1{font:800 clamp(2.2rem,5vw,4rem)/1.11 var(--font-display,'Plus Jakarta Sans',sans-serif);letter-spacing:-.05em;color:#002d59;max-width:850px;margin:0 0 23px}
  .purchase-lead{font:400 clamp(16px,1.65vw,19px)/1.8 var(--font-body,Inter,sans-serif);color:#415b75;max-width:780px;margin:0}
  .purchase-actions{display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin:29px 0 16px}
  .purchase-primary{font:800 13px/1.4 var(--font-display,'Plus Jakarta Sans',sans-serif);min-height:50px;border-radius:10px;border:1px solid #01488e;background:#01488e;color:white;cursor:pointer;padding:14px 20px;display:inline-flex;gap:20px;justify-content:center;align-items:center}
  .purchase-primary:hover{background:#002d59;border-color:#002d59}
  .purchase-secondary{font:650 13px/1.5 var(--font-body,Inter,sans-serif);color:#01488e;text-decoration:underline;text-underline-offset:4px}
  .purchase-note{font:400 12px/1.75 var(--font-body,Inter,sans-serif);color:#738398;max-width:760px}
  .purchase-section{padding:clamp(45px,6vw,84px) 0;border-top:1px solid #e2eaf2}
  .purchase-heading{max-width:740px;margin-bottom:30px}
  .purchase-heading h2,.purchase-related h2,.purchase-bottom h2{font:800 clamp(25px,3.2vw,38px)/1.18 var(--font-display,'Plus Jakarta Sans',sans-serif);letter-spacing:-.035em;color:#002d59;margin:0 0 13px}
  .purchase-heading>p:not(.purchase-eyebrow){font:400 15px/1.8 var(--font-body,Inter,sans-serif);color:#526982;margin:0}
  .purchase-option{display:flex;justify-content:space-between;align-items:center;gap:24px;border-bottom:1px solid #dfe8f0;padding:22px 0}
  .purchase-option:first-child{border-top:1px solid #dfe8f0}
  .purchase-option h3{font:750 18px/1.35 var(--font-display,'Plus Jakarta Sans',sans-serif);margin:0 0 8px}
  .purchase-option h3 a{text-decoration:none;color:#002d59}
  .purchase-option h3 a:hover{color:#01488e;text-decoration:underline}
  .purchase-option p{font:400 13px/1.7 var(--font-body,Inter,sans-serif);color:#5c6f82;margin:0;max-width:700px}
  .purchase-option-quote{border:1px solid #b5cde1;border-radius:8px;background:#fff;color:#01488e;font:750 12px/1.35 var(--font-body,Inter,sans-serif);padding:11px 15px;cursor:pointer;min-width:140px;display:inline-flex;justify-content:space-between;gap:11px}
  .purchase-option-quote:hover{background:#eaf2fb;border-color:#01488e}
  .purchase-guide{background:#f7fafd}
  .purchase-guide-layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(30px,6vw,84px)}
  .purchase-steps{list-style:none;padding:0;margin:0}
  .purchase-steps li{display:grid;grid-template-columns:40px 1fr;gap:20px;border-bottom:1px solid #d9e5f1;padding:0 0 21px;margin-bottom:21px}
  .purchase-steps li:last-child{margin-bottom:0;border:0}
  .purchase-step-number{font:750 13px/1.5 var(--font-display,'Plus Jakarta Sans',sans-serif);color:#01488e}
  .purchase-steps h3{font:750 15px/1.45 var(--font-display,'Plus Jakarta Sans',sans-serif);color:#19334f;margin:0 0 7px}
  .purchase-steps p{font:400 13px/1.75 var(--font-body,Inter,sans-serif);color:#526982;margin:0}
  .purchase-faqs{min-width:0}
  .purchase-faqs details{border-bottom:1px solid #dfe8f0}
  .purchase-faqs details:first-child{border-top:1px solid #dfe8f0}
  .purchase-faqs summary{cursor:pointer;list-style:none;position:relative;padding:20px 24px 20px 0;font:700 14px/1.55 var(--font-display,'Plus Jakarta Sans',sans-serif);color:#19334f}
  .purchase-faqs summary::after{content:'+';font-size:20px;position:absolute;right:2px;top:16px;color:#01488e}
  .purchase-faqs details[open] summary::after{content:'−'}
  .purchase-faqs p{font:400 13px/1.8 var(--font-body,Inter,sans-serif);color:#536982;margin:0 0 21px}
  .purchase-related{border-top:1px solid #dfe8f0;padding:46px 0 60px}
  .purchase-related h2{font-size:23px;margin-bottom:22px}
  .purchase-related-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
  .purchase-related-list a{display:block;text-decoration:none;border-top:2px solid #dbe7f2;padding-top:16px}
  .purchase-related-list a:hover{border-color:#01488e}
  .purchase-related-list strong{font:750 14px/1.4 var(--font-display,'Plus Jakarta Sans',sans-serif);display:block;color:#01488e;margin-bottom:7px}
  .purchase-related-list small{font:400 12px/1.7 var(--font-body,Inter,sans-serif);display:block;color:#64778a}
  .purchase-bottom{background:#eaf2fb;padding:clamp(42px,5vw,70px) 0}
  .purchase-bottom-layout{display:flex;gap:30px;justify-content:space-between;align-items:center}
  .purchase-bottom h2{max-width:680px}
  .purchase-bottom p:not(.purchase-eyebrow){font:400 14px/1.7 var(--font-body,Inter,sans-serif);color:#4f647a;max-width:630px;margin:0}
  .purchase-bottom .purchase-primary{flex-shrink:0}
  :global(.purchase-page button:focus-visible),.purchase-related-list a:focus-visible,.purchase-breadcrumb a:focus-visible{outline:3px solid #7fb8eb;outline-offset:3px}
  @media(max-width:800px){.purchase-guide-layout{grid-template-columns:1fr;gap:5px}.purchase-related-list{grid-template-columns:1fr}.purchase-bottom-layout{align-items:flex-start;flex-direction:column}}
  @media(max-width:560px){.purchase-container{width:calc(100% - 32px)}.purchase-hero{padding-top:16px}.purchase-breadcrumb{margin-bottom:32px}.purchase-option{align-items:stretch;flex-direction:column;gap:16px}.purchase-option-quote{align-self:flex-start}.purchase-actions{align-items:stretch;flex-direction:column}.purchase-primary{width:100%}.purchase-secondary{align-self:flex-start}.purchase-bottom .purchase-primary{align-self:stretch}.purchase-hero h1{font-size:2.15rem}}
</style>
