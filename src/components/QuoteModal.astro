---
/**
 * DEPOFIBRA v0.10.4 | Formulario CRM incrustado.
 * Conserva el modal y la llamada directa; sustituye FormSubmit.
 * El envío, las validaciones y las notificaciones pertenecen al CRM del
 * subdominio formulario.depofibra.com (no a GitHub Pages).
 * No se presume confirmación del envío en GA4: sin evento seguro del CRM.
 */
---

<div class="quote-overlay" id="quoteModal" role="dialog" aria-modal="true" aria-labelledby="quoteModalTitle" aria-describedby="quoteModalDesc" aria-hidden="true">
  <div class="quote-card">
    <button class="quote-close" id="quoteCloseBtn" type="button" aria-label="Cerrar formulario">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <span class="quote-eyebrow">CONTACTO COMERCIAL · DEPOFIBRA</span>
    <h2 id="quoteModalTitle" class="quote-title">Pedir presupuesto</h2>
    <p id="quoteModalDesc" class="quote-desc">Cuatro datos para empezar. Te ayudamos a encontrar el producto adecuado.</p>

    <!-- Alternativa directa al formulario: una llamada telefónica. -->
    <div class="quote-call" aria-label="Llamar sin rellenar el formulario">
      <div class="quote-call__intro">¿Prefieres hablar directamente con nosotros?</div>
      <a class="quote-call__link" href="tel:+34642129233" aria-label="Llamar ahora a Depofibra al 642 129 233">
        <span class="quote-call__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </span>
        <span class="quote-call__text"><strong>Llamar ahora · 642 129 233</strong><small>Abre la llamada, sin rellenar el formulario</small></span>
        <span class="quote-call__arrow" aria-hidden="true">↗</span>
      </a>
      <div class="quote-call__divider"><span>O envía tu consulta por escrito</span></div>
    </div>

    <section class="quote-embed" aria-label="Formulario de solicitud de presupuesto">
      <p class="quote-embed__context" id="quoteContext" hidden></p>
      <div class="quote-embed__frame">
        <iframe src="https://formulario.depofibra.com/f/ORHV1h16Sme9Jxz_oj2ovqgvbVVJjFNexIHLA4qqR4I" title="Pide tu presupuesto" data-crm-formulario loading="lazy" width="100%" height="900"></iframe>
      </div>
      <p class="quote-embed__note">La solicitud se gestiona en el formulario de Depofibra, sin salir de esta ventana.</p>
    </section>
  </div>
</div>

<!-- Script oficial del CRM: ajusta la altura del iframe mediante postMessage verificado. -->
<script is:inline src="https://formulario.depofibra.com/recursos/insertar.js" async></script>

<style>
  .quote-overlay{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,18,38,.72);backdrop-filter:blur(7px);opacity:0;visibility:hidden;transition:opacity .25s ease,visibility .25s ease}
  .quote-overlay.is-open{opacity:1;visibility:visible}
  .quote-card{position:relative;width:min(100%,740px);max-height:calc(100dvh - 32px);overflow-y:auto;overscroll-behavior:contain;padding:clamp(20px,3vw,30px);border-radius:22px;background:#fff;box-shadow:0 25px 65px rgba(0,18,38,.25);transform:translateY(12px) scale(.98);transition:transform .3s var(--ease-out)}
  .quote-overlay.is-open .quote-card{transform:translateY(0) scale(1)}
  .quote-close{position:absolute;right:15px;top:15px;width:40px;height:40px;border:0;border-radius:50%;display:grid;place-items:center;color:var(--color-gray-600);background:var(--color-gray-100);cursor:pointer}
  .quote-close:hover{background:var(--color-gray-200)}
  .quote-eyebrow{display:block;color:var(--color-primary);font:800 10px/1.2 var(--font-display);letter-spacing:.1em;margin-bottom:10px}
  .quote-title{color:var(--color-primary-dark);font:800 clamp(23px,3vw,29px)/1.13 var(--font-display);letter-spacing:-.04em;margin:0 42px 8px 0}
  .quote-desc{color:var(--color-gray-600);font:400 14px/1.6 var(--font-body);margin-bottom:12px;max-width:460px}
  .quote-call{margin:10px 0 16px}
  .quote-call__intro{color:var(--color-primary-dark);font:800 12px/1.4 var(--font-display);margin:0 0 9px}
  .quote-call__link{display:flex;align-items:center;gap:12px;min-height:64px;padding:10px 14px;border:1px solid #9fc3e0;border-radius:12px;background:#edf5fc;color:#002d59;text-decoration:none;transition:background .2s ease,border-color .2s ease,transform .2s ease}
  .quote-call__link:hover{background:#e3f0fb;border-color:#01488e;transform:translateY(-1px)}
  .quote-call__link:focus-visible{outline:3px solid #78b7f4;outline-offset:2px}
  .quote-call__icon{display:grid;place-items:center;flex:0 0 40px;width:40px;height:40px;border-radius:50%;background:#01488e;color:#fff}
  .quote-call__icon svg{width:21px;height:21px}
  .quote-call__text{flex:1;display:grid;gap:3px;min-width:0}
  .quote-call__text strong{font:800 13px/1.25 var(--font-display);letter-spacing:-.015em}
  .quote-call__text small{font:500 11px/1.35 var(--font-body);color:#536d85}
  .quote-call__arrow{font:800 17px/1 var(--font-display);color:#01488e;flex:none}
  .quote-call__divider{display:flex;align-items:center;gap:10px;margin:12px 0 0;color:#657789;font:600 11px/1.4 var(--font-body);text-align:center}
  .quote-call__divider::before,.quote-call__divider::after{content:"";height:1px;flex:1;background:#d5e0ea}
  .quote-call__divider span{flex:none}
  .quote-embed__context{margin:0 0 10px;padding:9px 12px;border:1px solid #d7e5f1;border-radius:10px;background:#f5f9fd;color:#002d59;font:600 12px/1.55 var(--font-body)}
  .quote-embed__context[hidden]{display:none}
  .quote-embed__frame{width:100%;min-height:400px}
  .quote-embed__frame iframe{display:block;width:100%;max-width:100%;height:900px;border:0;background:#fff}
  .quote-embed__note{margin:8px 0 0;color:#61778c;font:400 11px/1.5 var(--font-body)}
  @media(max-width:530px){.quote-overlay{padding:8px}.quote-card{max-height:calc(100dvh - 16px);padding:21px 14px;border-radius:16px}.quote-title{margin-bottom:7px}.quote-desc{margin-bottom:10px}.quote-call{margin:10px 0 13px}.quote-call__link{min-height:60px;padding:9px 11px}.quote-embed__frame iframe{min-height:680px}}
  @media(prefers-reduced-motion:reduce){.quote-overlay,.quote-card{transition:none}}
</style>

<script>
  const modal = document.getElementById('quoteModal');
  const closeBtn = document.getElementById('quoteCloseBtn');
  const context = document.getElementById('quoteContext');
  let previousFocus: HTMLElement | null = null;

  function openQuoteModal(product?: string, note?: string) {
    previousFocus = document.activeElement as HTMLElement;
    // La referencia solo se muestra como ayuda. No se transmite al CRM sin una API de prellenado documentada.
    const reference = [product?.trim(), note?.trim()].filter(Boolean).join(' · ');
    if (context) {
      context.textContent = reference ? `Consulta sobre: ${reference}. Indícalo en el formulario para que podamos identificar el producto.` : '';
      context.hidden = !reference;
    }
    modal?.classList.add('is-open');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => closeBtn?.focus({preventScroll: true}));
  }

  function closeQuoteModal() {
    modal?.classList.remove('is-open');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    previousFocus?.focus({preventScroll: true});
  }

  document.querySelectorAll<HTMLElement>('.open-quote-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      document.querySelectorAll('.mobile-panel.is-open').forEach(panel => panel.classList.remove('is-open'));
      openQuoteModal(trigger.dataset.product, trigger.dataset.note);
    });
  });
  closeBtn?.addEventListener('click', closeQuoteModal);
  modal?.addEventListener('click', event => { if (event.target === modal) closeQuoteModal(); });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && modal?.classList.contains('is-open')) closeQuoteModal();
  });

  // v0.10.5 | Confirmación de CRM (NO confundir con el cambio de altura del iframe).
  // El CRM debe emitir este mensaje SOLO cuando el servidor haya registrado
  // correctamente la solicitud. insertar.js actualmente NO emite ese mensaje.
  const crmFrame = modal?.querySelector<HTMLIFrameElement>('iframe[data-crm-formulario]');
  const crmOrigin = 'https://formulario.depofibra.com';
  let navigatingToConfirmation = false;

  window.addEventListener('message', (event: MessageEvent) => {
    // Solo aceptamos el origen del CRM y el iframe concreto de este modal.
    if (event.origin !== crmOrigin || event.source !== crmFrame?.contentWindow) return;
    if (!modal?.classList.contains('is-open') || navigatingToConfirmation) return;

    const message = event.data;
    // El CRM debe mandar un OBJETO explícito; nunca una altura, texto suelto
    // ni un mensaje genérico que pueda confundirse con otros eventos.
    if (!message || typeof message !== 'object' || Array.isArray(message)) return;
    if (message.type !== 'depofibra:crm:solicitud-registrada') return;

    navigatingToConfirmation = true;
    // No enviamos a GA4 el contenido del formulario ni datos de la persona.
    // La confirmación del proveedor y la entrega del correo son cosas distintas.
    window.location.assign('/solicitud-enviada/');
  });
</script>
