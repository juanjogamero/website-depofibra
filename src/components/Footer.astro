---
/**
 * Footer corporativo de Depofibra.
 * Diseño sofisticado con azul profundo corporativo.
 * CTA previo de presupuesto, columnas de navegación y datos legales.
 */
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Pie de página">
  <div class="footer-inner container">
    <!-- Columna de marca -->
    <div class="footer-brand-col">
      <a href="/" class="footer-brand" aria-label="Depofibra — Inicio">
        <span class="footer-brand__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
        </span>
        <span>Depofibra</span>
      </a>
      <p class="footer-desc">
        Comercialización de depósitos de poliéster reforzado con fibra de vidrio (PRFV) para riego y otros usos compatibles, piscinas, fosas sépticas, cubas y cisternas.
      </p>
      <span class="footer-location">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
        Casariche, Sevilla, España
      </span>
    </div>

    <!-- Explorar -->
    <div class="footer-col">
      <h2>Explorar</h2>
      <nav aria-label="Enlaces de navegación" class="footer-links">
        <a href="/">Inicio</a>
        <a href="/#catalogo">Catálogo de productos</a>
        <a href="/#guia-eleccion">Guía para elegir</a>
        <a href="/#preguntas-frecuentes">Preguntas frecuentes</a>
        <a href="/#logistica">Información de entrega</a>
      </nav>
    </div>

    <!-- Productos -->
    <div class="footer-col">
      <h2>Productos</h2>
      <nav aria-label="Categorías de productos" class="footer-links">
        <a href="/depositos/">Depósitos de poliéster</a>
        <a href="/piscinas/">Piscinas de poliéster</a>
        <a href="/fosas-septicas/">Fosas sépticas</a>
        <a href="/cubas-cisternas/">Cubas y cisternas</a>
      </nav>
    </div>

    <!-- Redes -->
    <div class="footer-col">
      <h2>Síguenos</h2>
      <nav aria-label="Redes sociales" class="footer-links">
        <a href="https://www.instagram.com/depofibra/" target="_blank" rel="noopener noreferrer">
          Instagram <span aria-hidden="true">↗</span>
        </a>
        <a href="https://www.facebook.com/p/Juan-Depofibra-61589376342997/" target="_blank" rel="noopener noreferrer">
          Facebook <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom container">
    <p class="footer-copyright">
      © {currentYear} Depofibra. Información de productos y condiciones sujeta a confirmación por referencia.
    </p>
    <nav aria-label="Información legal" class="footer-legal">
      <a href="/aviso-legal/">Aviso legal</a>
      <a href="/politica-de-privacidad/">Privacidad</a>
      <a href="/politica-de-cookies/">Cookies</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 48px 0 20px;
    color: #dbeafe;
    background: #082d52;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }

  /* Brand column */
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-white);
    font: 800 22px/1.2 var(--font-display);
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .footer-brand__mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--color-primary);
    color: var(--color-white);
  }

  .footer-brand__mark svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .footer-desc {
    max-width: 380px;
    margin: 14px 0 0;
    color: #cbd5e1;
    font-size: 13px;
    line-height: 1.75;
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    color: #dbeafe;
    font-size: 13px;
  }

  .footer-location svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  /* Columns */
  .footer-col h2 {
    margin: 0 0 14px;
    color: var(--color-white);
    font: 700 12px/1.4 var(--font-display);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-links a {
    color: #dbeafe;
    font-size: 13px;
    line-height: 1.5;
    text-decoration: none;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px solid rgba(219, 234, 254, 0.15);
  }

  .footer-copyright {
    color: #b7cbe0;
    font-size: 11px;
    line-height: 1.6;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-legal a {
    color: #b7cbe0;
    font-size: 11px;
    text-decoration: none;
    text-underline-offset: 3px;
    transition: color var(--transition-fast);
  }

  .footer-legal a:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  /* ═══ Desktop ═══ */
  @media (min-width: 769px) {
    .site-footer {
      padding: 56px 0 22px;
    }

    .footer-inner {
      grid-template-columns: minmax(220px, 1.5fr) repeat(3, minmax(120px, 0.72fr));
      gap: 36px;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 32px 20px;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
    }
  }
</style>
